            {% endif %}

          </div>
        {% endif %}

      </div>

    </div>
  </div>

  {% if product != blank %}
    <script type="application/json" id="ProductData-{{ section_id }}">
      {{ product | json }}
    </script>
  {% endif %}
</section>

<script>
  (function() {
    const sectionElement = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionElement) return;

    // --- Media Gallery Switching ---
    const thumbnailButtons = sectionElement.querySelectorAll('.fp-thumbnail-btn-{{ section_id }}');
    const mainSlides = sectionElement.querySelectorAll('.fp-main-media-slide-{{ section_id }}');

    function setActiveSlide(index) {
      thumbnailButtons.forEach(btn => {
        const isMatch = parseInt(btn.dataset.slideIndex, 10) === index;
        btn.classList.toggle('is-active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      mainSlides.forEach(slide => {
        const isMatch = parseInt(slide.dataset.slideIndex, 10) === index;
        slide.classList.toggle('is-active', isMatch);
      });
    }

    thumbnailButtons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const index = parseInt(this.dataset.slideIndex, 10);
        setActiveSlide(index);
      });
    });

    // --- Quantity Stepper ---
    const qtyInput = sectionElement.querySelector('[data-qty-input]');
    const decBtn = sectionElement.querySelector('[data-qty-decrement]');
    const incBtn = sectionElement.querySelector('[data-qty-increment]');

    if (qtyInput && decBtn && incBtn) {
      decBtn.addEventListener('click', function() {
        let val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) {
          qtyInput.value = val - 1;
          qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });

      incBtn.addEventListener('click', function() {
        let val = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = val + 1;
        qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
      });

      qtyInput.addEventListener('change', function() {
        let val = parseInt(this.value, 10);
        if (isNaN(val) || val < 1) {
          this.value = 1;
        }
      });
    }

    // --- Mock Option Pills (When no real product is attached) ---
    const mockPillButtons = sectionElement.querySelectorAll('[data-mock-options] .fp-pill-btn-{{ section_id }}');
    mockPillButtons.forEach(pill => {
      pill.addEventListener('click', function() {
        mockPillButtons.forEach(p => {
          p.classList.remove('is-active');
          p.setAttribute('aria-pressed', 'false');
        });
        this.classList.add('is-active');
        this.setAttribute('aria-pressed', 'true');
      });
    });

    // --- Real Shopify Product Variant Handling ---
    const productDataScript = document.getElementById('ProductData-{{ section_id }}');
    if (productDataScript) {
      let productData = null;
      try {
        productData = JSON.parse(productDataScript.textContent);
      } catch (err) {
        console.error('Failed to parse product data JSON', err);
      }

      if (productData && productData.variants) {
        const optionGroups = sectionElement.querySelectorAll('.fp-option-group-{{ section_id }}[data-option-index]');
        const masterVariantInput = sectionElement.querySelector('[data-master-variant-id]');
        const priceDisplay = sectionElement.querySelector('[data-price]');
        const comparePriceDisplay = sectionElement.querySelector('[data-compare-price]');
        const atcButton = sectionElement.querySelector('[data-atc-button]');
        const atcText = sectionElement.querySelector('[data-atc-text]');

        function getSelectedOptions() {
          const selected = [];
          optionGroups.forEach(group => {
            const activePill = group.querySelector('.fp-pill-btn-{{ section_id }}.is-active');
            if (activePill) {
              selected.push(activePill.dataset.optionValue);
            }
          });
          return selected;
        }

        function findMatchingVariant(selectedOptions) {
          return productData.variants.find(variant => {
            return selectedOptions.every((val, idx) => {
              const optionKey = 'option' + (idx + 1);
              return variant[optionKey] === val;
            });
          });
        }

        function formatMoney(cents) {
          if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
            return Shopify.formatMoney(cents);
          }
          return '$' + (cents / 100).toFixed(2);
        }

        optionGroups.forEach(group => {
          const pills = group.querySelectorAll('.fp-pill-btn-{{ section_id }}');
          pills.forEach(pill => {
            pill.addEventListener('click', function() {
              pills.forEach(p => {
                p.classList.remove('is-active');
                p.setAttribute('aria-pressed', 'false');
              });
              this.classList.add('is-active');
              this.setAttribute('aria-pressed', 'true');

              const selectedOptions = getSelectedOptions();
              const matchingVariant = findMatchingVariant(selectedOptions);

              if (matchingVariant) {
                if (masterVariantInput) {
                  masterVariantInput.value = matchingVariant.id;
                }

                // Update Price
                if (priceDisplay) {
                  priceDisplay.textContent = formatMoney(matchingVariant.price);
                }

                // Update Compare At Price
                if (comparePriceDisplay) {
                  if (matchingVariant.compare_at_price && matchingVariant.compare_at_price > matchingVariant.price) {
                    comparePriceDisplay.textContent = formatMoney(matchingVariant.compare_at_price);
                    comparePriceDisplay.style.display = 'inline-block';
                  } else {
                    comparePriceDisplay.style.display = 'none';
                  }
                }

                // Availability & ATC Button
                if (atcButton && atcText) {
                  if (matchingVariant.available) {
                    atcButton.disabled = false;
                    atcText.textContent = '{{ section.settings.button_text }}';
                  } else {
                    atcButton.disabled = true;
                    atcText.textContent = 'Sold Out';
                  }
                }

                // Switch featured media if variant has an associated media image
                if (matchingVariant.featured_media && matchingVariant.featured_media.id) {
                  const mediaId = matchingVariant.featured_media.id.toString();
                  const targetThumb = sectionElement.querySelector(`.fp-thumbnail-btn-{{ section_id }}[data-media-id="${mediaId}"]`);
                  if (targetThumb) {
                    const slideIndex = parseInt(targetThumb.dataset.slideIndex, 10);
                    setActiveSlide(slideIndex);
                  }
                }
              } else {
                if (atcButton && atcText) {
                  atcButton.disabled = true;
                  atcText.textContent = 'Unavailable';
                }
              }
            });
          });
        });
      }
    }

    // --- AJAX Add To Cart Submission ---
    const productForm = sectionElement.querySelector('.fp-form-{{ section_id }}');
    const feedbackBox = sectionElement.querySelector('[data-feedback-message]');
    const atcBtn = sectionElement.querySelector('[data-atc-button]');
    const atcLabel = sectionElement.querySelector('[data-atc-text]');

    if (productForm && atcBtn) {
      productForm.addEventListener('submit', function(e) {
        // If Shopify product isn't linked, provide simulated instant feedback
        const idInput = productForm.querySelector('[name="id"]');
        const masterVariantId = idInput ? idInput.value : null;
        if (!masterVariantId || masterVariantId === '1') {
          e.preventDefault();
          const origText = atcLabel.textContent;
          atcBtn.classList.add('is-loading');
          atcLabel.textContent = 'Adding...';
          setTimeout(() => {
            atcBtn.classList.remove('is-loading');
            atcLabel.textContent = '✓ Added to Cart!';
            if (feedbackBox) {
              feedbackBox.className = 'fp-feedback-{{ section_id }} is-success';
              feedbackBox.textContent = 'Added demo product to cart!';
            }
            setTimeout(() => {
              atcLabel.textContent = origText;
              if (feedbackBox) feedbackBox.className = 'fp-feedback-{{ section_id }}';
            }, 3000);
          }, 600);
          return;
        }

        e.preventDefault();
        const origText = atcLabel.textContent;
        atcBtn.classList.add('is-loading');
        atcBtn.disabled = true;
        atcLabel.textContent = 'Adding...';
        if (feedbackBox) feedbackBox.className = 'fp-feedback-{{ section_id }}';

        const formData = new FormData(productForm);
        const rootPath = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';

        fetch(rootPath + 'cart/add.js', {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          }
        })
        .then(response => {
          if (!response.ok) {
            return response.json().then(errData => { throw errData; });
          }
          return response.json();
        })
        .then(cartItem => {
          atcBtn.classList.remove('is-loading');
          atcBtn.disabled = false;
          atcLabel.textContent = '✓ Added to Cart!';

          if (feedbackBox) {
            feedbackBox.className = 'fp-feedback-{{ section_id }} is-success';
            feedbackBox.textContent = `"${cartItem.title || 'Product'}" has been added to your cart.`;
          }

          // Trigger standard theme events for cart drawers
          document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { item: cartItem } }));
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

          setTimeout(() => {
            atcLabel.textContent = origText;
            if (feedbackBox) feedbackBox.className = 'fp-feedback-{{ section_id }}';
          }, 3500);
        })
        .catch(err => {
          atcBtn.classList.remove('is-loading');
          atcBtn.disabled = false;
          atcLabel.textContent = origText;
          if (feedbackBox) {
            feedbackBox.className = 'fp-feedback-{{ section_id }} is-error';
            feedbackBox.textContent = err.description || err.message || 'Error adding to cart. Please try again.';
          }
        });
      });
    }

  })();
</script>

