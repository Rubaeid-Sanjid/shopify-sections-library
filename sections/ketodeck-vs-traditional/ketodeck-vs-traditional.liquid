      "default": 16
    },
    {
      "type": "range",
      "id": "cell_padding_x_mobile",
      "min": 8,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Cell Horizontal Padding (Mobile)",
      "default": 16
    },
    {
