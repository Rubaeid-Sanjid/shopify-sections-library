<script>
  (function() {
    class BrandingGrid{{ section_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 5;
        this.mobileLayout = this.dataset.mobileLayout;
        this.isTransitioning = false;
      }

      connectedCallback() {
        this.slider = this.querySelector('.new-custom-branding-grid__slider-{{ section_id }}');
        this.prevButton = this.querySelector('.new-custom-branding-grid__prev-{{ section_id }}');
        this.nextButton = this.querySelector('.new-custom-branding-grid__next-{{ section_id }}');
        this.dots = this.querySelectorAll('.new-custom-branding-grid__dot-{{ section_id }}');

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.updateButtons();

        let touchStartX = 0;
        let touchEndX = 0;
        let touchStartTime = 0;

        this.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
          touchStartTime = Date.now();
        }, { passive: true });

        this.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          const touchDuration = Date.now() - touchStartTime;
          this.handleSwipe(touchStartX, touchEndX, touchDuration);
        }, { passive: true });

        let mouseStartX = 0;
        let mouseEndX = 0;
        let isMouseDown = false;

        this.addEventListener('mousedown', (e) => {
          const isMobile = window.matchMedia('(max-width: 768px)').matches;
          if (!isMobile || this.mobileLayout !== 'slider') return;

          isMouseDown = true;
          mouseStartX = e.clientX;
        });

        this.addEventListener('mousemove', (e) => {
          if (!isMouseDown) return;
          e.preventDefault();
        });

        this.addEventListener('mouseup', (e) => {
          if (!isMouseDown) return;
          isMouseDown = false;
          mouseEndX = e.clientX;
          this.handleSwipe(mouseStartX, mouseEndX, 0);
        });
      }

      handleSwipe(startX, endX, duration) {
        const isMobile = window.matchMedia('(max-width: 768px)').matches;

        if (!isMobile || this.mobileLayout !== 'slider' || this.isTransitioning) return;

        const swipeDistance = startX - endX;
        const minSwipeDistance = 50;

        if (Math.abs(swipeDistance) < minSwipeDistance) return;

        if (swipeDistance > 0) {
          this.goToNextSlide();
        } else {
          this.goToPrevSlide();
        }
      }

      goToSlide(index) {
        if (this.isTransitioning || index === this.currentSlide) return;

        this.currentSlide = index;
        this.updateSlider();
        this.updateButtons();
        this.updateDots();
      }

      goToNextSlide() {
        if (this.isTransitioning || this.currentSlide >= this.totalSlides - 1) return;

        this.currentSlide++;
        this.updateSlider();
        this.updateButtons();
        this.updateDots();
      }

      goToPrevSlide() {
        if (this.isTransitioning || this.currentSlide <= 0) return;

        this.currentSlide--;
        this.updateSlider();
        this.updateButtons();
        this.updateDots();
      }

      updateSlider() {
        const isMobile = window.matchMedia('(max-width: 768px)').matches;

        if (isMobile && this.mobileLayout === 'slider' && this.slider) {
          this.isTransitioning = true;
          const offset = -this.currentSlide * 100;
          this.slider.style.transform = `translateX(${offset}%)`;

          setTimeout(() => {
            this.isTransitioning = false;
          }, 500);
        }
      }

      updateButtons() {
        if (this.prevButton && this.nextButton) {
          this.prevButton.disabled = this.currentSlide === 0;
          this.nextButton.disabled = this.currentSlide === this.totalSlides - 1;
        }
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.classList.remove('active');
            dot.removeAttribute('aria-current');
          }
        });
      }
    }

    customElements.define('branding-grid-{{ section_id }}', BrandingGrid{{ section_id }});
  })();
</script>

