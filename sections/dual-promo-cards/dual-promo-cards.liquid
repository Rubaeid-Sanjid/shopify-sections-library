          "options": [
            { "value": "bottom", "label": "Bottom" },
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" }
          ],
          "default": "bottom"
        },
        {
          "type": "header",
          "content": "Call to Action"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Shop travel picks"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "select",
          "id": "link_style",
          "label": "Link Presentation",
          "options": [
            { "value": "arrow", "label": "Text Link with Arrow" },
            { "value": "pill", "label": "Rounded Pill Button" }
          ],
          "default": "arrow"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
