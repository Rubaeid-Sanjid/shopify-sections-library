            "badge_icon": "gift",
            "badge_bg_color": "#bbf7d0",
            "badge_text_color": "#064e3b",
            "title": "The perfect gift",
            "description": "Give the people you love the gift of genuine relief.",
            "link_text": "Shop gifts",
            "link_color": "#76e5b5",
            "link_hover_color": "#a7f3d0",
            "show_arrow": true,
            "overlay_color": "#11262d",
            "overlay_opacity": 75
          }
        }
      ]
    }
  ]
