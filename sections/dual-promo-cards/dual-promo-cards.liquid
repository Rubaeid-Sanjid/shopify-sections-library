            { "value": "gift", "label": "Gift Box" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "bag", "label": "Shopping Bag" },
            { "value": "tag", "label": "Price Tag" },
            { "value": "compass", "label": "Compass" },
            { "value": "fire", "label": "Trending / Fire" },
            { "value": "truck", "label": "Delivery Truck" },
            { "value": "custom", "label": "Custom SVG Code" },
            { "value": "none", "label": "No Icon" }
          ],
          "default": "airplane"
        },
        {
          "type": "html",
          "id": "custom_badge_svg",
          "label": "Custom SVG Code (if icon set to Custom)"
        },
        {
          "type": "color",
          "id": "badge_bg_color",
          "label": "Badge Background Color",
          "default": "#bbf7d0"
        },
        {
          "type": "color",
          "id": "badge_text_color",
          "label": "Badge Text & Icon Color",
          "default": "#064e3b"
        },
        {
          "type": "header",
          "content": "Card Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Heading",
          "default": "Perfect for travel"
        },
        {
          "type": "select",
          "id": "title_tag",
          "label": "Heading HTML Tag",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "div", "label": "div" }
          ],
          "default": "h3"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Heading Color",
          "default": "#ffffff"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text",
          "default": "Fold it into your carry-on and arrive restored — not wrecked."
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description Color",
          "default": "#f3f4f6"
        },
        {
          "type": "select",
          "id": "content_vertical_align",
