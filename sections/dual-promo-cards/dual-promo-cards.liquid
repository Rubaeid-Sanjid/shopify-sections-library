        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open Link in New Tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dual Promo Cards",
      "blocks": [
        {
          "type": "promo_card",
          "settings": {
