        },
        {
          "type": "color",
          "id": "link_color",
          "label": "Link / Accent Color",
          "default": "#76e5b5"
        },
        {
          "type": "color",
          "id": "link_hover_color",
          "label": "Link Hover Color",
          "default": "#a7f3d0"
        },
        {
          "type": "checkbox",
          "id": "enable_full_card_link",
