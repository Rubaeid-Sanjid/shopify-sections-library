{% assign section_id = section.id | replace: '_', '' | downcase %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --dpc-section-bg: {{ section.settings.section_bg }};
    --dpc-max-width: {{ section.settings.container_max_width }}px;
    --dpc-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --dpc-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --dpc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --dpc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    /* Card Layout & Sizing */
    --dpc-card-radius: {{ section.settings.card_border_radius }}px;
    --dpc-card-min-height-desktop: {{ section.settings.card_min_height_desktop }}px;
    --dpc-card-min-height-mobile: {{ section.settings.card_min_height_mobile }}px;
    --dpc-card-gap-desktop: {{ section.settings.card_gap_desktop }}px;
    --dpc-card-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --dpc-card-padding-desktop: {{ section.settings.card_padding_desktop }}px;
    --dpc-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;

    /* Global Section Header */
    --dpc-header-eyebrow-color: {{ section.settings.header_eyebrow_color }};
    --dpc-header-heading-color: {{ section.settings.header_heading_color }};
    --dpc-header-desc-color: {{ section.settings.header_desc_color }};

    background-color: var(--dpc-section-bg);
    position: relative;
    width: 100%;
    display: block;
    box-sizing: border-box;
  }

  .dpc-section-{{ section_id }} {
    padding-top: var(--dpc-padding-top-mobile);
    padding-bottom: var(--dpc-padding-bottom-mobile);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #ffffff;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .dpc-section-{{ section_id }} {
      padding-top: var(--dpc-padding-top-desktop);
      padding-bottom: var(--dpc-padding-bottom-desktop);
    }
  }

  .dpc-container-{{ section_id }} {
    width: 100%;
    max-width: var(--dpc-max-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .dpc-container-{{ section_id }} {
      padding-left: 32px;
      padding-right: 32px;
    }
  }

  /* Optional Section Header */
  .dpc-header-{{ section_id }} {
    margin-bottom: 36px;
    box-sizing: border-box;
  }

  .dpc-header-{{ section_id }}.text-center {
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .dpc-header-{{ section_id }}.text-left {
    text-align: left;
  }

  .dpc-header-eyebrow-{{ section_id }} {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--dpc-header-eyebrow-color);
    margin-bottom: 10px;
  }

  .dpc-header-heading-{{ section_id }} {
    font-size: clamp(26px, 3.5vw, 42px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--dpc-header-heading-color);
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }

  .dpc-header-desc-{{ section_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: var(--dpc-header-desc-color);
    margin: 0;
  }

  /* Cards Grid */
  .dpc-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--dpc-card-gap-mobile);
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .dpc-grid-{{ section_id }} {
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
      gap: var(--dpc-card-gap-desktop);
    }
  }

  /* Mobile Swipe Slider Mode */
  @media (max-width: 767px) {
    .dpc-grid-{{ section_id }}.dpc-layout-swipe {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 12px;
      margin-left: -20px;
      margin-right: -20px;
      padding-left: 20px;
      padding-right: 20px;
      gap: var(--dpc-card-gap-mobile);
      scrollbar-width: none;
    }

    .dpc-grid-{{ section_id }}.dpc-layout-swipe::-webkit-scrollbar {
      display: none;
    }

    .dpc-grid-{{ section_id }}.dpc-layout-swipe .dpc-card-{{ section_id }} {
      flex: 0 0 calc(88vw - 20px);
      max-width: 440px;
      scroll-snap-align: start;
    }
  }

  /* Promo Card Component */
  .dpc-card-{{ section_id }} {
    position: relative;
    border-radius: var(--dpc-card-radius);
    overflow: hidden;
    min-height: var(--dpc-card-min-height-mobile);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    isolation: isolate;
    background-color: #111827;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .dpc-card-{{ section_id }} {
      min-height: var(--dpc-card-min-height-desktop);
    }
  }

  {% if section.settings.enable_hover_lift %}
    @media (hover: hover) {
      .dpc-card-{{ section_id }}:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.18);
      }
    }
  {% endif %}

  /* Card Media / Background */
  .dpc-media-wrapper-{{ section_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .dpc-media-image-{{ section_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  {% if section.settings.enable_image_zoom %}
    @media (hover: hover) {
      .dpc-card-{{ section_id }}:hover .dpc-media-image-{{ section_id }},
      .dpc-card-{{ section_id }}:hover .dpc-placeholder-svg {
        transform: scale(1.05);
      }
    }
  {% endif %}

  .dpc-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Overlay Gradient */
  .dpc-card-overlay-{{ section_id }} {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* Card Content Layer */
  .dpc-content-wrapper-{{ section_id }} {
    position: relative;
    z-index: 3;
    padding: var(--dpc-card-padding-mobile);
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  @media (min-width: 768px) {
    .dpc-content-wrapper-{{ section_id }} {
      padding: var(--dpc-card-padding-desktop);
    }
  }

  /* Content Alignment Options */
  .dpc-align-bottom {
    justify-content: flex-end;
  }

  .dpc-align-top {
    justify-content: flex-start;
  }

  .dpc-align-center {
    justify-content: center;
  }

  /* Badge Pill */
  .dpc-badge-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    width: fit-content;
    margin-bottom: 14px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    user-select: none;
  }

  .dpc-badge-icon-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  .dpc-badge-icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* Card Heading */
  .dpc-card-title-{{ section_id }} {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0 0 10px 0;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
  }

  /* Card Description */
  .dpc-card-desc-{{ section_id }} {
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 18px 0;
    color: rgba(255, 255, 255, 0.92);
    max-width: 440px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 768px) {
    .dpc-card-desc-{{ section_id }} {
      font-size: 16px;
    }
  }

  /* CTA Link / Button */
  .dpc-cta-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.2;
    transition: all 0.25s ease;
    cursor: pointer;
    width: fit-content;
  }

  .dpc-cta-arrow-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dpc-cta-arrow-{{ section_id }} svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) {
    .dpc-card-{{ section_id }}:hover .dpc-cta-arrow-{{ section_id }},
    .dpc-cta-{{ section_id }}:hover .dpc-cta-arrow-{{ section_id }} {
      transform: translateX(5px);
    }
  }

  /* Pill button CTA style */
  .dpc-cta-style-pill {
    padding: 10px 22px;
    border-radius: 9999px;
    background-color: var(--dpc-cta-btn-bg, #ffffff);
    color: var(--dpc-cta-btn-text, #111827);
  }

  @media (hover: hover) {
    .dpc-cta-style-pill:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }
  }

  /* Full Card Clickable Overlay */
  .dpc-card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    text-indent: -9999px;
    overflow: hidden;
  }

  .dpc-card-link-overlay:focus-visible {
    outline: 3px solid #38bdf8;
    outline-offset: -3px;
  }
{%- endstyle -%}

<section class="dpc-section-{{ section_id }}" aria-label="{{ section.settings.heading | default: 'Promotions' | escape }}">
  <div class="dpc-container-{{ section_id }}">
    
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="dpc-header-{{ section_id }} text-{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="dpc-header-eyebrow-{{ section_id }}">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dpc-header-heading-{{ section_id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="dpc-header-desc-{{ section_id }}">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="dpc-grid-{{ section_id }} dpc-layout-{{ section.settings.mobile_layout }}">
      {%- for block in section.blocks -%}
        {%- assign b_index = forloop.index -%}
        {%- assign card_id = block.id | replace: '_', '' | downcase -%}

        {%- style -%}
          #dpc-card-{{ card_id }} {
            --dpc-card-title-color: {{ block.settings.title_color }};
            --dpc-card-desc-color: {{ block.settings.description_color }};
            --dpc-badge-bg: {{ block.settings.badge_bg_color }};
            --dpc-badge-color: {{ block.settings.badge_text_color }};
            --dpc-cta-color: {{ block.settings.link_color }};
            --dpc-cta-hover-color: {{ block.settings.link_hover_color }};
          }

          #dpc-card-{{ card_id }} .dpc-card-overlay-{{ section_id }} {
            background: linear-gradient(
              to top,
              {{ block.settings.overlay_color }} 0%,
              {{ block.settings.overlay_color | color_modify: 'alpha', 0.82 }} {{ block.settings.overlay_gradient_mid }}%,
              {{ block.settings.overlay_color | color_modify: 'alpha', 0.25 }} 78%,
              transparent 100%
            );
            opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
          }

          #dpc-card-{{ card_id }} .dpc-badge-{{ section_id }} {
            background-color: var(--dpc-badge-bg);
            color: var(--dpc-badge-color);
          }

          #dpc-card-{{ card_id }} .dpc-card-title-{{ section_id }} {
            color: var(--dpc-card-title-color);
          }

          #dpc-card-{{ card_id }} .dpc-card-desc-{{ section_id }} {
            color: var(--dpc-card-desc-color);
          }

          #dpc-card-{{ card_id }} .dpc-cta-{{ section_id }} {
            color: var(--dpc-cta-color);
          }

          @media (hover: hover) {
            #dpc-card-{{ card_id }} .dpc-cta-{{ section_id }}:hover {
              color: var(--dpc-cta-hover-color);
            }
          }
        {%- endstyle -%}

        <div class="dpc-card-{{ section_id }}" id="dpc-card-{{ card_id }}" {{ block.shopify_attributes }}>
          
          {%- comment -%} Background Media Layer {%- endcomment -%}
          <div class="dpc-media-wrapper-{{ section_id }}">
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 767px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 480 }} 480w, {{ block.settings.image_mobile | image_url: width: 768 }} 768w"
                    sizes="(max-width: 767px) 88vw, 768px"
                  >
                {%- endif -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 1024px) 600px, (min-width: 768px) 50vw, 88vw"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  class="dpc-media-image-{{ section_id }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </picture>
            {%- else -%}
              {%- comment -%} Built-in Fallback Vector Placeholders {%- endcomment -%}
              {%- if b_index == 1 -%}
                {%- comment -%} Card 1 Fallback: Flatlay Travel Essentials {%- endcomment -%}
                <svg class="dpc-placeholder-svg" viewBox="0 0 700 500" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Travel essentials flatlay illustration">
                  <rect width="700" height="500" fill="#2d251e"/>
                  <!-- Wood Grain Planks Background -->
                  <rect width="700" height="500" fill="url(#wood-grad-{{ card_id }})"/>
                  <line x1="0" y1="125" x2="700" y2="125" stroke="#231c16" stroke-width="2"/>
                  <line x1="0" y1="250" x2="700" y2="250" stroke="#231c16" stroke-width="2"/>
                  <line x1="0" y1="375" x2="700" y2="375" stroke="#231c16" stroke-width="2"/>
                  
                  <!-- Leather Weekend Duffle Bag Left -->
                  <g filter="url(#shadow-{{ card_id }})">
                    <rect x="70" y="80" width="170" height="340" rx="36" fill="#8c4e28"/>
                    <rect x="85" y="95" width="140" height="310" rx="26" fill="#753e1e"/>
                    <path d="M125 80 V50 C125 40 185 40 185 50 V80" stroke="#5a2f15" stroke-width="12" stroke-linecap="round"/>
                    <line x1="155" y1="95" x2="155" y2="405" stroke="#5a2f15" stroke-width="4" stroke-dasharray="6 4"/>
                    <rect x="135" y="210" width="40" height="40" rx="8" fill="#a45d31"/>
                    <circle cx="155" cy="230" r="6" fill="#d99b64"/>
                  </g>

                  <!-- Travel Neck Massager Device Center -->
                  <g filter="url(#shadow-{{ card_id }})">
                    <path d="M330 180 C330 130 430 130 430 180 C430 240 400 270 380 270 C360 270 330 240 330 180 Z" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="6"/>
                    <circle cx="350" cy="190" r="14" fill="#94a3b8"/>
                    <circle cx="410" cy="190" r="14" fill="#94a3b8"/>
                    <rect x="365" y="240" width="30" height="12" rx="6" fill="#64748b"/>
                  </g>

                  <!-- Glasses Case & Accessories -->
                  <g filter="url(#shadow-{{ card_id }})">
                    <rect x="420" y="190" width="130" height="60" rx="18" fill="#653b24"/>
                    <rect x="425" y="195" width="120" height="50" rx="14" fill="#4a2a19"/>
                    <!-- Power Bank & Passport -->
                    <rect x="390" y="90" width="45" height="75" rx="10" fill="#1e293b"/>
                    <rect x="450" y="90" width="40" height="75" rx="8" fill="#d4d4d8"/>
                    <rect x="340" y="290" width="90" height="110" rx="8" fill="#1e3a5f"/>
                    <rect x="350" y="300" width="70" height="40" rx="4" fill="#3b82f6" opacity="0.3"/>
                    <line x1="355" y1="360" x2="410" y2="360" stroke="#ffffff" stroke-width="3" opacity="0.6"/>
                    <line x1="355" y1="375" x2="395" y2="375" stroke="#ffffff" stroke-width="3" opacity="0.6"/>
                  </g>

                  <defs>
                    <linearGradient id="wood-grad-{{ card_id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#4a3627"/>
                      <stop offset="50%" stop-color="#3b2b1f"/>
                      <stop offset="100%" stop-color="#2a1e15"/>
                    </linearGradient>
                    <filter id="shadow-{{ card_id }}" x="-10%" y="-10%" width="130%" height="130%">
                      <feDropShadow dx="0" dy="12" stdDeviation="10" flood-color="#000000" flood-opacity="0.45"/>
                    </filter>
                  </defs>
                </svg>
              {%- else -%}
                {%- comment -%} Card 2 Fallback: Luxury Gift Box Lifestyle Scene {%- endcomment -%}
                <svg class="dpc-placeholder-svg" viewBox="0 0 700 500" preserveAspectRatio="xMidYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Hands holding luxury gift box illustration">
                  <rect width="700" height="500" fill="#243038"/>
                  <rect width="700" height="500" fill="url(#room-grad-{{ card_id }})"/>
                  <!-- Warm Interior Bokeh / Soft lights -->
                  <circle cx="200" cy="140" r="90" fill="#fef08a" opacity="0.08"/>
                  <circle cx="580" cy="100" r="110" fill="#fed7aa" opacity="0.09"/>
                  <circle cx="120" cy="300" r="70" fill="#a7f3d0" opacity="0.06"/>

                  <!-- Plant Silhouette in Background -->
                  <path d="M120 220 Q150 140 190 160 Q170 200 130 230 Z" fill="#134e4a" opacity="0.3"/>
                  <path d="M140 240 Q200 130 230 180 Q190 220 150 250 Z" fill="#064e3b" opacity="0.25"/>

                  <!-- Luxury White Presentation Gift Box with Ribbon -->
                  <g filter="url(#shadow-box-{{ card_id }})" transform="translate(40, -10)">
                    <!-- Lower Box Base -->
                    <polygon points="340,190 490,215 440,330 290,300" fill="#e2e8f0"/>
                    <!-- Lid Top -->
                    <polygon points="330,175 480,200 450,225 300,198" fill="#ffffff"/>
                    <!-- Lid Sides -->
                    <polygon points="300,198 450,225 445,250 295,220" fill="#f1f5f9"/>
                    <polygon points="450,225 480,200 475,225 445,250" fill="#cbd5e1"/>

                    <!-- Silk Ribbon -->
                    <path d="M365 183 L385 235 L380 285" stroke="#fef3c7" stroke-width="12" stroke-linecap="round" fill="none"/>
                    <path d="M410 191 L360 213" stroke="#fde68a" stroke-width="10" stroke-linecap="round" fill="none"/>
                    <!-- Ribbon Bow Accent -->
                    <circle cx="375" cy="186" r="12" fill="#fbbf24"/>
                    <path d="M375 186 C355 170 345 190 375 186 Z" fill="#fde68a"/>
                    <path d="M375 186 C395 170 405 190 375 186 Z" fill="#fde68a"/>

                    <!-- Gentle Hands Holding Box Base -->
                    <path d="M240 280 Q275 295 310 290 Q305 325 250 330 Z" fill="#e0a98b" opacity="0.9"/>
                    <path d="M470 240 Q510 270 540 310 Q495 340 450 300 Z" fill="#d09272" opacity="0.9"/>
                  </g>

                  <defs>
                    <linearGradient id="room-grad-{{ card_id }}" x1="20%" y1="0%" x2="80%" y2="100%">
                      <stop offset="0%" stop-color="#3d4946"/>
                      <stop offset="50%" stop-color="#233535"/>
                      <stop offset="100%" stop-color="#122123"/>
                    </linearGradient>
                    <filter id="shadow-box-{{ card_id }}" x="-20%" y="-20%" width="150%" height="150%">
                      <feDropShadow dx="0" dy="16" stdDeviation="14" flood-color="#000000" flood-opacity="0.5"/>
                    </filter>
                  </defs>
                </svg>
              {%- endif -%}
            {%- endif -%}
          </div>

          {%- comment -%} Gradient Overlay {%- endcomment -%}
          <div class="dpc-card-overlay-{{ section_id }}"></div>

          {%- comment -%} Card Content {%- endcomment -%}
          <div class="dpc-content-wrapper-{{ section_id }} dpc-align-{{ block.settings.content_vertical_align }}">
            
            {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
              <div class="dpc-badge-{{ section_id }}">
                {%- if block.settings.badge_icon != 'none' -%}
                  <span class="dpc-badge-icon-{{ section_id }}">
                    {%- case block.settings.badge_icon -%}
                      {%- when 'airplane' -%}
                        <svg viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
                      {%- when 'gift' -%}
                        <svg viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.65-.5-.65C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1h-2.22l.53-.79c.35-.53.94-.88 1.69-.88zM9 4c.75 0 1.34.35 1.69.88l.53.79H9c-.55 0-1-.45-1-1s.45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76V14h2V8.76L15.38 12 17 10.83 14.92 8H20v6z"/></svg>
                      {%- when 'sparkles' -%}
                        <svg viewBox="0 0 24 24"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2zm7 13l1.2 3.3L23.5 19.5l-3.3 1.2L19 24l-1.2-3.3-3.3-1.2 3.3-1.2L19 15zM5 2l1.2 3.3L9.5 6.5 6.2 7.7 5 11 3.8 7.7.5 6.5 3.8 5.3 5 2z"/></svg>
                      {%- when 'star' -%}
                        <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                      {%- when 'heart' -%}
                        <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                      {%- when 'bag' -%}
                        <svg viewBox="0 0 24 24"><path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>
                      {%- when 'tag' -%}
                        <svg viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
                      {%- when 'compass' -%}
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-5.5l2.5-5.5 5.5-2.5-2.5 5.5-5.5 2.5zm4-2.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5z"/></svg>
                      {%- when 'fire' -%}
                        <svg viewBox="0 0 24 24"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>
                      {%- when 'truck' -%}
                        <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
                      {%- when 'custom' -%}
                        {{ block.settings.custom_badge_svg }}
                    {%- endcase -%}
                  </span>
                {%- endif -%}
                <span>{{ block.settings.badge_text | escape }}</span>
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <{{ block.settings.title_tag | default: 'h3' }} class="dpc-card-title-{{ section_id }}">
                {{ block.settings.title | escape }}
              </{{ block.settings.title_tag | default: 'h3' }}>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="dpc-card-desc-{{ section_id }}">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

            {%- if block.settings.link_text != blank -%}
              <a
                href="{{ block.settings.link_url | default: '#' }}"
                class="dpc-cta-{{ section_id }} dpc-cta-style-{{ block.settings.link_style | default: 'arrow' }}"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                <span>{{ block.settings.link_text | escape }}</span>
                {%- if block.settings.show_arrow -%}
                  <span class="dpc-cta-arrow-{{ section_id }}" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                {%- endif -%}
              </a>
            {%- endif -%}

          </div>

          {%- comment -%} Optional Full-Card Clickable Overlay {%- endcomment -%}
          {%- if block.settings.enable_full_card_link and block.settings.link_url != blank -%}
            <a
              href="{{ block.settings.link_url }}"
              class="dpc-card-link-overlay"
              aria-label="{{ block.settings.title | default: block.settings.link_text | escape }}"
              {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ block.settings.title | default: 'View promotion' | escape }}
            </a>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Dual Promo Cards",
  "tag": "section",
  "class": "section-dual-promo-cards",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Desktop Columns",
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout Style",
      "options": [
        {
          "value": "stacked",
          "label": "Vertical Stack"
        },
        {
          "value": "swipe",
          "label": "Swipeable Carousel (Peek Cards)"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "header",
      "content": "Card Sizing & Spacing"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_min_height_desktop",
      "min": 320,
      "max": 650,
      "step": 10,
      "unit": "px",
      "label": "Card Min Height (Desktop)",
      "default": 440
    },
    {
      "type": "range",
      "id": "card_min_height_mobile",
      "min": 280,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Card Min Height (Mobile)",
      "default": 360
    },
    {
      "type": "range",
      "id": "card_gap_desktop",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding_desktop",
      "min": 20,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Inner Padding (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_padding_mobile",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Inner Padding (Mobile)",
      "default": 24
    },
    {
      "type": "header",
      "content": "Hover Effects"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable Image Zoom on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_hover_lift",
      "label": "Enable Card Lift on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Optional Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "placeholder": "CURATED COLLECTIONS"
    },
    {
      "type": "color",
      "id": "header_eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#059669"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "placeholder": "Discover our collections"
    },
    {
      "type": "color",
      "id": "header_heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "color",
      "id": "header_desc_color",
      "label": "Description Color",
      "default": "#4b5563"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
