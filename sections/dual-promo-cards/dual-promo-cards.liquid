        {
          "type": "header",
          "content": "Pill Badge"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Travel Essentials"
        },
        {
          "type": "select",
          "id": "badge_icon",
