{% assign section_id = section.id | replace: '_', '' | downcase %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-bg: {{ section.settings.section_bg }};
    --container-max-width: {{ section.settings.container_max_width }}px;
    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    /* Laser Line Variables */
    --laser-color: {{ section.settings.laser_color }};
    --laser-glow-color: {{ section.settings.laser_glow_color }};
    --laser-thickness: {{ section.settings.laser_thickness }}px;
    --laser-glow-blur: {{ section.settings.laser_glow_blur }}px;
    --laser-opacity: {{ section.settings.laser_opacity | divided_by: 100.0 }};

    /* Tag & Typography */
    --tag-color: {{ section.settings.tag_color }};
    --tag-font-size-desktop: {{ section.settings.tag_font_size_desktop }}px;
    --tag-font-size-mobile: {{ section.settings.tag_font_size_mobile }}px;
    --tag-letter-spacing: {{ section.settings.tag_letter_spacing }}px;
    --gap-size: {{ section.settings.gap_size }}px;

    background-color: var(--section-bg);
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .laser-divider-section-{{ section_id }} {
    padding-top: var(--padding-top-mobile);
    padding-bottom: var(--padding-bottom-mobile);
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  @media (min-width: 768px) {
    .laser-divider-section-{{ section_id }} {
      padding-top: var(--padding-top-desktop);
      padding-bottom: var(--padding-bottom-desktop);
    }
  }

  .laser-divider-container-{{ section_id }} {
    max-width: var(--container-max-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    box-sizing: border-box;
  }

  .laser-divider-wrapper-{{ section_id }} {
    display: flex;
    align-items: center;
    width: 100%;
    gap: var(--gap-size);
    position: relative;
    {% if section.settings.content_alignment == 'left' %}
      justify-content: flex-start;
    {% elsif section.settings.content_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: center;
    {% endif %}
  }

  /* Laser Beams */
  .laser-beam-left-{{ section_id }},
  .laser-beam-right-{{ section_id }} {
    height: var(--laser-thickness);
    opacity: var(--laser-opacity);
    box-shadow: 0 0 var(--laser-glow-blur) var(--laser-glow-color);
    transition: opacity 0.3s ease, box-shadow 0.3s ease;
  }

  .laser-beam-left-{{ section_id }} {
    {% if section.settings.content_alignment == 'left' %}
      flex: 0 0 60px;
    {% else %}
      flex: 1;
    {% endif %}
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.05) 20%, var(--laser-color) 100%);
  }

  .laser-beam-right-{{ section_id }} {
    {% if section.settings.content_alignment == 'right' %}
      flex: 0 0 60px;
    {% else %}
      flex: 1;
    {% endif %}
    background: linear-gradient(90deg, var(--laser-color) 0%, rgba(255, 255, 255, 0.05) 80%, transparent 100%);
  }

  {% if section.settings.enable_pulse %}
    @keyframes laser-pulse-{{ section_id }} {
      0%, 100% {
        opacity: var(--laser-opacity);
        box-shadow: 0 0 var(--laser-glow-blur) var(--laser-glow-color);
      }
      50% {
        opacity: calc(var(--laser-opacity) * 1.35);
        box-shadow: 0 0 calc(var(--laser-glow-blur) * 1.6) var(--laser-glow-color), 0 0 2px #ffffff;
      }
    }

    .laser-beam-left-{{ section_id }},
    .laser-beam-right-{{ section_id }} {
      animation: laser-pulse-{{ section_id }} {{ section.settings.pulse_speed }}s ease-in-out infinite;
    }
  {% endif %}

  /* Center Tag */
  .laser-divider-tag-{{ section_id }} {
    flex-shrink: 0;
    {% if section.settings.tag_font_family == 'monospace' %}
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    {% elsif section.settings.tag_font_family == 'heading' %}
      font-family: var(--font-heading-family, inherit);
    {% elsif section.settings.tag_font_family == 'body' %}
      font-family: var(--font-body-family, inherit);
    {% else %}
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    {% endif %}
    font-size: var(--tag-font-size-mobile);
    text-transform: {{ section.settings.text_transform }};
    letter-spacing: var(--tag-letter-spacing);
    color: var(--tag-color);
    line-height: 1;
    font-weight: {{ section.settings.font_weight }};
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.25s ease, text-shadow 0.25s ease;
    user-select: none;
    padding: 0 4px;
  }

  @media (min-width: 768px) {
    .laser-divider-tag-{{ section_id }} {
      font-size: var(--tag-font-size-desktop);
    }
  }

  {% if section.settings.tag_link != blank %}
    a.laser-divider-tag-{{ section_id }}:hover {
      color: {{ section.settings.laser_color }};
      text-shadow: 0 0 10px var(--laser-glow-color);
    }
  {% endif %}
{%- endstyle -%}

<section class="laser-divider-section-{{ section_id }}" aria-label="{{ section.settings.tag_text | escape }}">
  <div class="laser-divider-container-{{ section_id }}">
    <div class="laser-divider-wrapper-{{ section_id }}">
      {%- if section.settings.show_laser_lines -%}
        <div class="laser-beam-left-{{ section_id }}" aria-hidden="true"></div>
      {%- endif -%}

      {%- if section.settings.tag_text != blank -%}
        {%- if section.settings.tag_link != blank -%}
          <a href="{{ section.settings.tag_link }}" class="laser-divider-tag-{{ section_id }}">
            {{ section.settings.tag_text | escape }}
          </a>
        {%- else -%}
          <span class="laser-divider-tag-{{ section_id }}">
            {{ section.settings.tag_text | escape }}
          </span>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_laser_lines -%}
        <div class="laser-beam-right-{{ section_id }}" aria-hidden="true"></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Laser Line Divider",
  "tag": "section",
  "class": "section-laser-line-divider",
  "settings": [
    {
      "type": "header",
      "content": "Content & Text"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Divider Text",
      "default": "01 — THE PROBLEM"
    },
    {
      "type": "url",
      "id": "tag_link",
      "label": "Text Link (Optional)",
      "info": "Optional link URL or anchor ID (e.g. #problem)"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "none", "label": "None" }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Text Color",
      "default": "#ef4444"
    },
    {
      "type": "range",
      "id": "tag_font_size_desktop",
      "min": 9,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Desktop)",
      "default": 11
    },
    {
      "type": "range",
      "id": "tag_font_size_mobile",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "tag_letter_spacing",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 3.5
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "tag_font_family",
      "label": "Font Family",
      "options": [
        { "value": "monospace", "label": "Monospace" },
        { "value": "sans", "label": "Sans-serif" },
        { "value": "heading", "label": "Theme Heading Font" },
        { "value": "body", "label": "Theme Body Font" }
      ],
      "default": "monospace"
    },
    {
      "type": "range",
      "id": "gap_size",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Text & Lines",
      "default": 16
    },
    {
      "type": "header",
      "content": "Laser Lines"
    },
    {
      "type": "checkbox",
      "id": "show_laser_lines",
      "label": "Show Laser Lines",
      "default": true
    },
    {
      "type": "color",
      "id": "laser_color",
      "label": "Laser Beam Color",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "laser_glow_color",
      "label": "Laser Glow Color",
      "default": "rgba(239, 68, 68, 0.45)"
    },
    {
      "type": "range",
      "id": "laser_thickness",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Laser Beam Thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "laser_glow_blur",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Glow Blur Radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "laser_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Laser Opacity",
      "default": 85
    },
    {
      "type": "header",
      "content": "Laser Pulse Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_pulse",
      "label": "Enable Laser Pulse Animation",
      "default": false
    },
    {
      "type": "range",
      "id": "pulse_speed",
      "min": 1,
      "max": 6,
      "step": 0.5,
      "unit": "s",
      "label": "Pulse Duration",
      "default": 3
    },
    {
      "type": "header",
      "content": "Section Layout & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 600,
      "max": 1800,
      "step": 40,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Laser Line Divider",
      "settings": {
        "tag_text": "01 — THE PROBLEM",
        "tag_color": "#ef4444",
        "laser_color": "#ef4444",
        "laser_thickness": 1,
        "content_alignment": "center"
      }
    }
  ]
}
{% endschema %}
