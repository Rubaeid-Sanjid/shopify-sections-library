{% if section.settings.comparison_mode == 'slider' %}
  <script>
    (function() {
      function initVrsSliders() {
        var section = document.getElementById('shopify-section-{{ section.id }}');
        if (!section) return;
        var containers = section.querySelectorAll('[data-vrs-slider]');

        containers.forEach(function(container) {
          var beforeLayer = container.querySelector('[data-vrs-before]');
          var handle = container.querySelector('[data-vrs-handle]');
          if (!beforeLayer || !handle) return;

          var isDragging = false;

          function setPosition(xPos) {
            var rect = container.getBoundingClientRect();
            var offsetX = xPos - rect.left;
            var percentage = Math.max(0, Math.min(100, (offsetX / rect.width) * 100));

            beforeLayer.style.width = percentage + '%';
            handle.style.left = percentage + '%';
          }

          function onMouseDown(e) {
            isDragging = true;
            setPosition(e.clientX);
          }

          function onMouseMove(e) {
            if (!isDragging) return;
            setPosition(e.clientX);
          }

          function onMouseUp() {
            isDragging = false;
          }

          function onTouchStart(e) {
            isDragging = true;
            if (e.touches && e.touches[0]) {
              setPosition(e.touches[0].clientX);
            }
          }

          function onTouchMove(e) {
            if (!isDragging) return;
            if (e.touches && e.touches[0]) {
              setPosition(e.touches[0].clientX);
            }
          }

          container.addEventListener('mousedown', onMouseDown);
          window.addEventListener('mousemove', onMouseMove);
          window.addEventListener('mouseup', onMouseUp);

          container.addEventListener('touchstart', onTouchStart, { passive: true });
          window.addEventListener('touchmove', onTouchMove, { passive: true });
          window.addEventListener('touchend', onMouseUp);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initVrsSliders);
      } else {
        initVrsSliders();
      }

      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail.sectionId === '{{ section.id }}') {
          initVrsSliders();
        }
      });
    })();
  </script>
{% endif %}

