</div>

{%- comment -%} Mobile Slider Behavior Script {%- endcomment -%}
{%- if section.settings.mobile_layout == 'slider' and section.blocks.size > 1 -%}
  <script>
    (function() {
      var sectionId = {{ section_id | json }};
      var track = document.getElementById('hiw-track-' + sectionId);
      var dotsWrap = document.getElementById('hiw-dots-' + sectionId);
      if (!track || !dotsWrap) return;

      var dots = dotsWrap.querySelectorAll('.hiw-dot-' + sectionId);
      var cards = track.querySelectorAll('.hiw-card-' + sectionId);
      if (!dots.length || !cards.length) return;

      // Scroll to clicked dot's step
      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var idx = parseInt(dot.getAttribute('data-dot-index'), 10);
          if (!isNaN(idx) && cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
          }
        });
      });

      // Update active dot on scroll
      var scrollTimeout;
      track.addEventListener('scroll', function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(function() {
          var trackRect = track.getBoundingClientRect();
          var closestIndex = 0;
          var minDiff = Infinity;

          cards.forEach(function(card, idx) {
            var cardRect = card.getBoundingClientRect();
            var diff = Math.abs(cardRect.left - trackRect.left);
            if (diff < minDiff) {
              minDiff = diff;
              closestIndex = idx;
            }
          });

          dots.forEach(function(d, i) {
            if (i === closestIndex) {
              d.classList.add('is-active');
            } else {
              d.classList.remove('is-active');
            }
          });
        }, 60);
      }, { passive: true });
    })();
  </script>
{%- endif -%}

