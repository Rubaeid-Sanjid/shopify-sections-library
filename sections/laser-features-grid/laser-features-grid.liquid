{% assign section_id = section.id | replace: '_', '' | downcase %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-bg: {{ section.settings.section_bg }};
    --container-max-width: {{ section.settings.container_max_width }}px;
    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    /* Laser Divider */
    --laser-color: {{ section.settings.laser_color }};
    --laser-glow-color: {{ section.settings.laser_glow_color }};
    --laser-thickness: {{ section.settings.laser_thickness }}px;
    --tag-color: {{ section.settings.tag_color }};
    --tag-font-size: {{ section.settings.tag_font_size }}px;
    --tag-letter-spacing: {{ section.settings.tag_letter_spacing }}px;
    --header-margin-bottom: {{ section.settings.header_margin_bottom }}px;

    /* Grid & Cards */
    --grid-columns-desktop: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --card-hover-bg-color: {{ section.settings.card_hover_bg_color }};
    --grid-gap-color: {{ section.settings.grid_gap_color }};
    --grid-border-color: {{ section.settings.grid_border_color }};
    --card-border-radius: {{ section.settings.card_border_radius }}px;
    --card-padding: {{ section.settings.card_padding }}px;

    /* Icon Box */
    --accent-color: {{ section.settings.accent_color }};
    --icon-box-border-color: {{ section.settings.icon_box_border_color }};
    --icon-box-bg-color: {{ section.settings.icon_box_bg_color }};
    --icon-glow-color: {{ section.settings.icon_glow_color }};
    --icon-size: {{ section.settings.icon_size }}px;
    --icon-box-size: {{ section.settings.icon_box_size }}px;

    /* Typography */
    --title-color: {{ section.settings.title_color }};
    --title-font-size: {{ section.settings.title_font_size }}px;
    --desc-color: {{ section.settings.desc_color }};
    --desc-font-size: {{ section.settings.desc_font_size }}px;

    background-color: var(--section-bg);
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .laser-features-section-{{ section_id }} {
    padding-top: var(--padding-top-mobile);
    padding-bottom: var(--padding-bottom-mobile);
    position: relative;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .laser-features-section-{{ section_id }} {
      padding-top: var(--padding-top-desktop);
      padding-bottom: var(--padding-bottom-desktop);
    }
  }

  .laser-features-container-{{ section_id }} {
    max-width: var(--container-max-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    box-sizing: border-box;
  }

  /* Laser Divider Header */
  .laser-features-divider-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    margin-bottom: var(--header-margin-bottom);
    position: relative;
  }

  .laser-line-left-{{ section_id }} {
    flex: 1;
    height: var(--laser-thickness);
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.05) 20%, var(--laser-color) 100%);
    box-shadow: 0 0 10px var(--laser-glow-color);
    opacity: 0.85;
  }

  .laser-line-right-{{ section_id }} {
    flex: 1;
    height: var(--laser-thickness);
    background: linear-gradient(90deg, var(--laser-color) 0%, rgba(255, 255, 255, 0.05) 80%, transparent 100%);
    box-shadow: 0 0 10px var(--laser-glow-color);
    opacity: 0.85;
  }

  .laser-tag-{{ section_id }} {
    flex-shrink: 0;
    {% if section.settings.tag_font_family == 'monospace' %}
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    {% elsif section.settings.tag_font_family == 'heading' %}
      font-family: var(--font-heading-family, inherit);
    {% elsif section.settings.tag_font_family == 'body' %}
      font-family: var(--font-body-family, inherit);
    {% else %}
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    {% endif %}
    font-size: var(--tag-font-size);
    text-transform: uppercase;
    letter-spacing: var(--tag-letter-spacing);
    color: var(--tag-color);
    line-height: 1;
    font-weight: 600;
    white-space: nowrap;
    user-select: none;
  }

  /* Grid Layout with Hairline Borders */
  .laser-features-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-desktop), minmax(0, 1fr));
    gap: 1px;
    background-color: var(--grid-gap-color);
    border: 1px solid var(--grid-border-color);
    border-radius: var(--card-border-radius);
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 1024px) and (min-width: 641px) {
    .laser-features-grid-{{ section_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .laser-features-grid-{{ section_id }} {
      grid-template-columns: repeat(var(--grid-columns-mobile), minmax(0, 1fr));
    }
  }

  /* Individual Feature Card */
  .laser-features-card-{{ section_id }} {
    position: relative;
    background-color: var(--card-bg-color);
    padding: var(--card-padding);
    transition: background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
    text-decoration: none;
  }

  .laser-features-card-{{ section_id }}:hover {
    background-color: var(--card-hover-bg-color);
  }

  /* Icon Box */
  .laser-features-icon-box-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-box-size);
    height: var(--icon-box-size);
    border-radius: 12px;
    border: 1px solid var(--icon-box-border-color);
    background-color: var(--icon-box-bg-color);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
  }

  .laser-features-icon-box-{{ section_id }} svg {
    width: var(--icon-size);
    height: var(--icon-size);
    color: var(--accent-color);
    stroke: var(--accent-color);
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .laser-features-icon-box-{{ section_id }} img {
    width: var(--icon-size);
    height: var(--icon-size);
    object-fit: contain;
    flex-shrink: 0;
  }

  /* Glow on Hover or if Permanent Glow is Active */
  .laser-features-card-{{ section_id }}:hover .laser-features-icon-box-{{ section_id }},
  .laser-features-icon-box-{{ section_id }}.has-glow {
    border-color: var(--accent-color);
    box-shadow: 0 0 20px -2px var(--icon-glow-color), inset 0 0 10px -1px var(--icon-glow-color);
    transform: translateY(-1px);
  }

  .laser-features-card-{{ section_id }}:hover .laser-features-icon-box-{{ section_id }} svg {
    transform: scale(1.06);
  }

  /* Card Typography */
  .laser-features-title-{{ section_id }} {
    margin-top: 1.5rem;
    margin-bottom: 0;
    font-size: var(--title-font-size);
    font-weight: 600;
    line-height: 1.35;
    color: var(--title-color);
    {% if section.settings.title_font_family == 'heading' %}
      font-family: var(--font-heading-family, inherit);
    {% elsif section.settings.title_font_family == 'body' %}
      font-family: var(--font-body-family, inherit);
    {% endif %}
  }

  .laser-features-desc-{{ section_id }} {
    margin-top: 0.5rem;
    margin-bottom: 0;
    font-size: var(--desc-font-size);
    line-height: 1.6;
    color: var(--desc-color);
    {% if section.settings.desc_font_family == 'body' %}
      font-family: var(--font-body-family, inherit);
    {% endif %}
  }

  .laser-features-card-link-{{ section_id }} {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: pointer;
  }
{%- endstyle -%}

<section class="laser-features-section-{{ section_id }}" aria-label="{{ section.settings.tag_text | escape }}">
  <div class="laser-features-container-{{ section_id }}">
    {%- if section.settings.show_header and section.settings.tag_text != blank -%}
      <div class="laser-features-divider-{{ section_id }}">
        <div class="laser-line-left-{{ section_id }}" aria-hidden="true"></div>
        <span class="laser-tag-{{ section_id }}">{{ section.settings.tag_text | escape }}</span>
        <div class="laser-line-right-{{ section_id }}" aria-hidden="true"></div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="laser-features-grid-{{ section_id }}">
        {%- for block in section.blocks -%}
          <div class="laser-features-card-{{ section_id }} group" {{ block.shopify_attributes }}>
            {%- if block.settings.card_link != blank -%}
              <a href="{{ block.settings.card_link }}" class="laser-features-card-link-{{ section_id }}" aria-label="{{ block.settings.title | escape }}"></a>
            {%- endif -%}

            <div class="laser-features-icon-box-{{ section_id }}{% if block.settings.enable_permanent_glow %} has-glow{% endif %}">
              {%- if block.settings.custom_svg != blank -%}
                {{ block.settings.custom_svg }}
              {%- elsif block.settings.custom_icon_image != blank -%}
                <img
                  src="{{ block.settings.custom_icon_image | image_url: width: 80 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="40"
                  height="40"
                >
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'keyboard' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 8h.01"></path>
                      <path d="M12 12h.01"></path>
                      <path d="M14 8h.01"></path>
                      <path d="M16 12h.01"></path>
                      <path d="M18 8h.01"></path>
                      <path d="M6 8h.01"></path>
                      <path d="M7 16h10"></path>
                      <path d="M8 12h.01"></path>
                      <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    </svg>

                  {%- when 'bluetooth' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m7 7 10 10-5 5V2l5 5L7 17"></path>
                    </svg>

                  {%- when 'battery' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="16" height="10" x="2" y="7" rx="2" ry="2"></rect>
                      <line x1="22" x2="22" y1="11" y2="13"></line>
                    </svg>

                  {%- when 'mouse_pointer' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"></path>
                    </svg>

                  {%- when 'cpu' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="16" height="16" x="4" y="4" rx="2"></rect>
                      <rect width="6" height="6" x="9" y="9" rx="1"></rect>
                      <path d="M15 2v2"></path>
                      <path d="M15 20v2"></path>
                      <path d="M2 15h2"></path>
                      <path d="M2 9h2"></path>
                      <path d="M20 15h2"></path>
                      <path d="M20 9h2"></path>
                      <path d="M9 2v2"></path>
                      <path d="M9 20v2"></path>
                    </svg>

                  {%- when 'wifi' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 20h.01"></path>
                      <path d="M2 8.82a15 15 0 0 1 20 0"></path>
                      <path d="M5 12.859a10 10 0 0 1 14 0"></path>
                      <path d="M8.5 16.429a5 5 0 0 1 7 0"></path>
                    </svg>

                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                    </svg>

                  {%- when 'zap' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path>
                    </svg>

                  {%- when 'sparkles' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                    </svg>

                  {%- when 'star' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>

                  {%- when 'check_circle' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <path d="m9 11 3 3L22 4"></path>
                    </svg>

                  {%- when 'settings' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="3"></circle>
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>

                  {%- else -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="laser-features-title-{{ section_id }}">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="laser-features-desc-{{ section_id }}">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Laser Features Grid",
  "tag": "section",
  "class": "section-laser-features-grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 64
    },
    {
      "type": "header",
      "content": "Laser Divider Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Header",
      "default": true
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag Text",
      "default": "02 — Features"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag Color",
      "default": "rgba(239, 68, 68, 0.75)"
    },
    {
      "type": "range",
      "id": "tag_font_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tag Font Size",
      "default": 10
    },
    {
      "type": "range",
      "id": "tag_letter_spacing",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "unit": "px",
      "label": "Tag Letter Spacing",
      "default": 3
    },
    {
      "type": "select",
      "id": "tag_font_family",
      "label": "Tag Font Family",
      "options": [
        { "value": "monospace", "label": "Monospace" },
        { "value": "sans", "label": "Sans-serif" },
        { "value": "heading", "label": "Theme Heading Font" },
        { "value": "body", "label": "Theme Body Font" }
      ],
      "default": "monospace"
    },
    {
      "type": "color",
      "id": "laser_color",
      "label": "Laser Line Color",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "laser_glow_color",
      "label": "Laser Glow Color",
      "default": "rgba(239, 68, 68, 0.45)"
    },
    {
      "type": "range",
      "id": "laser_thickness",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Laser Thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Header Bottom Margin",
      "default": 64
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Outer Border Radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 16,
      "max": 56,
      "step": 4,
      "unit": "px",
      "label": "Card Inner Padding",
      "default": 32
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
