{% assign section_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .custom-testimonial-slider-{{ section_id }} {
    width: 100%;
    padding: 0px 20px 60px 20px;
    overflow: hidden;
    display: block;
  }

  .custom-testimonial-slider__container-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .custom-testimonial-slider__header-{{ section_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .custom-testimonial-slider__title-{{ section_id }} {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;

    font-weight: 600;
  }

  .custom-testimonial-slider__subtitle-{{ section_id }} {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
  }

  .custom-testimonial-slider__wrapper-{{ section_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    min-height: 700px;
  }

  .custom-testimonial-slider__track-{{ section_id }} {
    position: relative;
    width: 100%;
    max-width: 900px;
    height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-testimonial-slider__card-{{ section_id }} {
    position: absolute;
    width: 350px;
    height: auto;
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translateX(100px) scale(0.9);
  }

  .custom-testimonial-slider__card-{{ section_id }}.active {
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  .custom-testimonial-slider__card-{{ section_id }}.center {
    z-index: 3;
    transform: translateX(0) scale(1.1);
    opacity: 1;
  }

  .custom-testimonial-slider__card-{{ section_id }}.left {
    z-index: 2;
    transform: translateX(-280px) scale(0.9) rotateY(15deg);
    opacity: 0.7;
  }

  .custom-testimonial-slider__card-{{ section_id }}.right {
    z-index: 2;
    transform: translateX(280px) scale(0.9) rotateY(-15deg);
    opacity: 0.7;
  }

  .custom-testimonial-slider__card-image-{{ section_id }} {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: top;
  }

  .custom-testimonial-slider__card-content-{{ section_id }} {
    padding: 30px 25px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .custom-testimonial-slider__stars-{{ section_id }} {
    display: flex;
    gap: 4px;
  }

  .custom-testimonial-slider__star-{{ section_id }} {
    width: 20px;
    height: 20px;
    color: {{ section.settings.star_color }};
  }

  .custom-testimonial-slider__review-{{ section_id }} {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.review_text_color }};
    margin: 0;
  }

  .custom-testimonial-slider__verified-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: {{ section.settings.verified_color }};
    font-weight: 600;
  }

  .custom-testimonial-slider__verified-icon-{{ section_id }} {
    width: 16px;
    height: 16px;
  }

  .custom-testimonial-slider__nav-button-{{ section_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: {{ section.settings.nav_button_bg }};
    color: {{ section.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    flex-shrink: 0;
    z-index: 10;
  }

  .custom-testimonial-slider__nav-button-{{ section_id }}:hover {
    background: {{ section.settings.nav_button_hover_bg }};
    transform: scale(1.1);
  }

  .custom-testimonial-slider__nav-icon-{{ section_id }} {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 1024px) {
    .custom-testimonial-slider__card-{{ section_id }}.left,
    .custom-testimonial-slider__card-{{ section_id }}.right {
      transform: translateX(0) scale(0.85);
      opacity: 0;
      pointer-events: none;
    }

    .custom-testimonial-slider__card-{{ section_id }}.center {
      transform: translateX(0) scale(1);
    }

    .custom-testimonial-slider__track-{{ section_id }} {
      max-width: 400px;
    }
  }

  @media screen and (max-width: 768px) {
    .custom-testimonial-slider__wrapper-{{ section_id }} {
      gap: 15px;
    }

    .custom-testimonial-slider__card-{{ section_id }} {
      width: 300px;
      height: auto;
    }

    .custom-testimonial-slider__track-{{ section_id }} {
      max-width: 320px;
      height: 420px;
    }

    .custom-testimonial-slider__nav-button-{{ section_id }} {
      width: 40px;
      height: 40px;
    }

    .custom-testimonial-slider__nav-icon-{{ section_id }} {
      width: 20px;
      height: 20px;
    }

    .custom-testimonial-slider__title-{{ section_id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.63);
    }

    .custom-testimonial-slider__subtitle-{{ section_id }} {
      font-size: calc({{ section.settings.subheading_size }}px * 0.85);
    }
  }
{% endstyle %}

<testimonial-slider-{{ section_id }} class="custom-testimonial-slider-{{ section_id }}">
  <div class="custom-testimonial-slider__container-{{ section_id }}">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="custom-testimonial-slider__header-{{ section_id }}">
        {% if section.settings.heading != blank %}
          <h2 class="custom-testimonial-slider__title-{{ section_id }}">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="custom-testimonial-slider__subtitle-{{ section_id }}">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="custom-testimonial-slider__wrapper-{{ section_id }}">
      <button class="custom-testimonial-slider__nav-button-{{ section_id }}" data-direction="prev" aria-label="Previous testimonial">
        <svg class="custom-testimonial-slider__nav-icon-{{ section_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="custom-testimonial-slider__track-{{ section_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'testimonial_' | append: i | append: '_image'
            assign review_key = 'testimonial_' | append: i | append: '_review'
            assign rating_key = 'testimonial_' | append: i | append: '_rating'
            assign verified_key = 'testimonial_' | append: i | append: '_verified'

            assign testimonial_image = section.settings[image_key]
            assign testimonial_review = section.settings[review_key]
            assign testimonial_rating = section.settings[rating_key]
            assign testimonial_verified = section.settings[verified_key]
          %}

          <div class="custom-testimonial-slider__card-{{ section_id }}" data-index="{{ forloop.index0 }}">
            {% if testimonial_image %}
              <img
                src="{{ testimonial_image | image_url: width: 400 }}"
                alt="Testimonial {{ i }}"
                class="custom-testimonial-slider__card-image-{{ section_id }}"
                loading="lazy"
                width="400"
                height="180"
              >
            {% else %}
              <div class="custom-testimonial-slider__card-image-{{ section_id }}" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="custom-testimonial-slider__card-content-{{ section_id }}">
              <div class="custom-testimonial-slider__stars-{{ section_id }}">
                {% for star in (1..5) %}
                  <svg class="custom-testimonial-slider__star-{{ section_id }}" viewBox="0 0 24 24" fill="{% if star <= testimonial_rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                {% endfor %}
              </div>

              <p class="custom-testimonial-slider__review-{{ section_id }}">
                {% if testimonial_review != blank %}
                  {{ testimonial_review }}
                {% else %}
                  Add your customer review here to showcase authentic feedback and build trust with potential buyers.
                {% endif %}
              </p>

              {% if testimonial_verified %}
                <div class="custom-testimonial-slider__verified-{{ section_id }}">
                  <svg class="custom-testimonial-slider__verified-icon-{{ section_id }}" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  {{ section.settings.verified_text }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <button class="custom-testimonial-slider__nav-button-{{ section_id }}" data-direction="next" aria-label="Next testimonial">
        <svg class="custom-testimonial-slider__nav-icon-{{ section_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</testimonial-slider-{{ section_id }}>

<script>
  (function() {
    class TestimonialSlider{{ section_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cards = [];
        this.totalCards = 0;
      }

      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('.custom-testimonial-slider__card-{{ section_id }}'));
        this.totalCards = this.cards.length;

        const prevButton = this.querySelector('[data-direction="prev"]');
        const nextButton = this.querySelector('[data-direction="next"]');

        prevButton.addEventListener('click', () => this.navigate(-1));
        nextButton.addEventListener('click', () => this.navigate(1));

        this.updateCards();
      }

      navigate(direction) {
        this.currentIndex = (this.currentIndex + direction + this.totalCards) % this.totalCards;
        this.updateCards();
      }

      updateCards() {
        this.cards.forEach((card, index) => {
          card.classList.remove('center', 'left', 'right', 'active');

          const position = (index - this.currentIndex + this.totalCards) % this.totalCards;

          if (position === 0) {
            card.classList.add('center', 'active');
          } else if (position === this.totalCards - 1) {
            card.classList.add('left', 'active');
          } else if (position === 1) {
            card.classList.add('right', 'active');
          }
        });
      }
    }

    customElements.define('testimonial-slider-{{ section_id }}', TestimonialSlider{{ section_id }});
  })();
</script>

