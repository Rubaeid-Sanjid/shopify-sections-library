    {
      "type": "range",
      "id": "column_gap_desktop",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Column gap (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Column gap (mobile)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Story Text Column"
    },
    {
      "type": "text",
      "id": "content_eyebrow",
      "label": "Eyebrow / Kicker",
      "placeholder": "e.g. SELF-CARE SUNDAY"
    },
    {
      "type": "range",
      "id": "content_eyebrow_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow font size",
      "default": 12
    },
    {
