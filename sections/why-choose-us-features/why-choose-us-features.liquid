<section class="wcu-section-{{ section_id }}" id="WhyChooseUs-{{ section.id }}" data-section-id="{{ section.id }}">
  {% if section.settings.enable_ambient_glow %}
    <div class="wcu-ambient-glow-{{ section_id }}" aria-hidden="true"></div>
  {% endif %}

  <div class="wcu-container-{{ section_id }}">
    {% comment %} Section Header {% endcomment %}
    {% if section.settings.show_header %}
      <div class="wcu-header-{{ section_id }}">
        {% if section.settings.eyebrow_text != blank %}
          <div class="wcu-eyebrow-{{ section_id }}">
            {% if section.settings.show_eyebrow_icon %}
              <span class="wcu-eyebrow-icon-{{ section_id }}">
                {% if section.settings.custom_eyebrow_icon != blank %}
                  {{ section.settings.custom_eyebrow_icon }}
                {% else %}
                  {{ icon_paw_print }}
                {% endif %}
              </span>
            {% endif %}
            <span>{{ section.settings.eyebrow_text }}</span>
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_tag }} class="wcu-heading-{{ section_id }}">
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="wcu-subheading-{{ section_id }}">
            {{ section.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% comment %} Separation of Left and Right Blocks {% endcomment %}
    {% assign left_blocks_count = 0 %}
    {% assign right_blocks_count = 0 %}

    {% for block in section.blocks %}
      {% if block.settings.column_position == 'left' %}
        {% assign left_blocks_count = left_blocks_count | plus: 1 %}
      {% elsif block.settings.column_position == 'right' %}
        {% assign right_blocks_count = right_blocks_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% comment %} Main Layout Grid {% endcomment %}
    <div class="wcu-layout-{{ section_id }}">
      
      {% comment %} Left Feature Column {% endcomment %}
      <div class="wcu-column-{{ section_id }} wcu-column--left-{{ section_id }}">
        {% for block in section.blocks %}
          {% assign is_left = false %}
          {% if block.settings.column_position == 'left' %}
            {% assign is_left = true %}
          {% elsif block.settings.column_position == 'auto' %}
            {% assign remainder = forloop.index | modulo: 2 %}
            {% if remainder == 1 %}
              {% assign is_left = true %}
            {% endif %}
          {% endif %}

          {% if is_left %}
            {% capture card_content %}
              {% if block.settings.card_link != blank %}
                <a href="{{ block.settings.card_link }}" class="wcu-card-{{ section_id }}" {{ block.shopify_attributes }}>
              {% else %}
                <div class="wcu-card-{{ section_id }}" {{ block.shopify_attributes }}>
              {% endif %}
                
                <div class="wcu-icon-box-{{ section_id }}"
                     style="{% if block.settings.custom_icon_bg != blank %}background-color: {{ block.settings.custom_icon_bg }};{% endif %}{% if block.settings.custom_icon_border != blank %}border-color: {{ block.settings.custom_icon_border }};{% endif %}">
                  <div class="wcu-icon-inner-{{ section_id }}" style="{% if block.settings.custom_icon_color != blank %}color: {{ block.settings.custom_icon_color }};{% endif %}">
                    {% if block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
                      <img src="{{ block.settings.icon_image | image_url: width: 120 }}" 
                           alt="{{ block.settings.icon_image.alt | default: block.settings.title | escape }}" 
                           loading="lazy" 
                           width="60" 
                           height="60">
                    {% elsif block.settings.icon_type == 'custom_svg' and block.settings.custom_svg_code != blank %}
                      {{ block.settings.custom_svg_code }}
                    {% else %}
                      {% case block.settings.icon_preset %}
                        {% when 'smart_feeder' %}
                          {{ icon_smart_feeder }}
                        {% when 'walks_leash' %}
                          {{ icon_walks_leash }}
                        {% when 'grooming_tools' %}
                          {{ icon_grooming_tools }}
                        {% when 'travel_ready' %}
                          {{ icon_travel_ready }}
                        {% when 'healthy_food' %}
                          {{ icon_healthy_food }}
                        {% when 'free_shipping' %}
                          {{ icon_free_shipping }}
                        {% when 'paw_print' %}
                          {{ icon_paw_print }}
                        {% when 'heart_care' %}
                          {{ icon_heart_care }}
                        {% when 'shield_quality' %}
                          {{ icon_shield_quality }}
                        {% when 'star_badge' %}
                          {{ icon_star_badge }}
                        {% when 'clock_support' %}
                          {{ icon_clock_support }}
                        {% when 'organic_leaf' %}
                          {{ icon_organic_leaf }}
                        {% else %}
                          {{ icon_paw_print }}
                      {% endcase %}
                    {% endif %}
                  </div>
                </div>

                {% if block.settings.badge_text != blank %}
                  <span class="wcu-card-badge-{{ section_id }}">{{ block.settings.badge_text }}</span>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h3 class="wcu-card-title-{{ section_id }}">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="wcu-card-desc-{{ section_id }}">{{ block.settings.description }}</div>
                {% endif %}

              {% if block.settings.card_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            {% endcapture %}
            {{ card_content }}
          {% endif %}
        {% endfor %}
      </div>

      {% comment %} Center Featured Media {% endcomment %}
      <div class="wcu-center-media-{{ section_id }}">
        <div class="wcu-image-wrapper-{{ section_id }}">
          {% if section.settings.center_image != blank %}
            <img src="{{ section.settings.center_image | image_url: width: 1000 }}" 
                 alt="{{ section.settings.center_image.alt | default: section.settings.heading | escape }}" 
                 class="wcu-image-{{ section_id }}" 
                 loading="lazy"
                 width="{{ section.settings.center_image.width }}"
                 height="{{ section.settings.center_image.height }}">
          {% elsif section.settings.fallback_image_url != blank %}
            <img src="{{ section.settings.fallback_image_url }}" 
                 alt="{{ section.settings.heading | escape }}" 
                 class="wcu-image-{{ section_id }}" 
                 loading="lazy">
          {% else %}
            {% comment %} High quality default cute dog transparent cutout fallback {% endcomment %}
            <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=800&q=80" 
                 alt="Featured Pet" 
                 class="wcu-image-{{ section_id }}" 
                 loading="lazy">
          {% endif %}
        </div>

        {% if section.settings.enable_pedestal_shadow %}
          <div class="wcu-pedestal-shadow-{{ section_id }}" aria-hidden="true"></div>
        {% endif %}
      </div>

      {% comment %} Right Feature Column {% endcomment %}
      <div class="wcu-column-{{ section_id }} wcu-column--right-{{ section_id }}">
        {% for block in section.blocks %}
          {% assign is_right = false %}
          {% if block.settings.column_position == 'right' %}
            {% assign is_right = true %}
          {% elsif block.settings.column_position == 'auto' %}
            {% assign remainder = forloop.index | modulo: 2 %}
            {% if remainder == 0 %}
              {% assign is_right = true %}
            {% endif %}
          {% endif %}

          {% if is_right %}
            {% if block.settings.card_link != blank %}
              <a href="{{ block.settings.card_link }}" class="wcu-card-{{ section_id }}" {{ block.shopify_attributes }}>
            {% else %}
              <div class="wcu-card-{{ section_id }}" {{ block.shopify_attributes }}>
            {% endif %}
              
              <div class="wcu-icon-box-{{ section_id }}"
                   style="{% if block.settings.custom_icon_bg != blank %}background-color: {{ block.settings.custom_icon_bg }};{% endif %}{% if block.settings.custom_icon_border != blank %}border-color: {{ block.settings.custom_icon_border }};{% endif %}">
                <div class="wcu-icon-inner-{{ section_id }}" style="{% if block.settings.custom_icon_color != blank %}color: {{ block.settings.custom_icon_color }};{% endif %}">
                  {% if block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
                    <img src="{{ block.settings.icon_image | image_url: width: 120 }}" 
                         alt="{{ block.settings.icon_image.alt | default: block.settings.title | escape }}" 
                         loading="lazy" 
                         width="60" 
                         height="60">
                  {% elsif block.settings.icon_type == 'custom_svg' and block.settings.custom_svg_code != blank %}
                    {{ block.settings.custom_svg_code }}
                  {% else %}
                    {% case block.settings.icon_preset %}
                      {% when 'smart_feeder' %}
                        {{ icon_smart_feeder }}
                      {% when 'walks_leash' %}
                        {{ icon_walks_leash }}
                      {% when 'grooming_tools' %}
                        {{ icon_grooming_tools }}
                      {% when 'travel_ready' %}
                        {{ icon_travel_ready }}
                      {% when 'healthy_food' %}
                        {{ icon_healthy_food }}
                      {% when 'free_shipping' %}
                        {{ icon_free_shipping }}
                      {% when 'paw_print' %}
                        {{ icon_paw_print }}
                      {% when 'heart_care' %}
                        {{ icon_heart_care }}
                      {% when 'shield_quality' %}
                        {{ icon_shield_quality }}
                      {% when 'star_badge' %}
                        {{ icon_star_badge }}
                      {% when 'clock_support' %}
                        {{ icon_clock_support }}
                      {% when 'organic_leaf' %}
                        {{ icon_organic_leaf }}
                      {% else %}
                        {{ icon_paw_print }}
                    {% endcase %}
                  {% endif %}
                </div>
              </div>

              {% if block.settings.badge_text != blank %}
                <span class="wcu-card-badge-{{ section_id }}">{{ block.settings.badge_text }}</span>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="wcu-card-title-{{ section_id }}">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="wcu-card-desc-{{ section_id }}">{{ block.settings.description }}</div>
              {% endif %}

            {% if block.settings.card_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

    </div>

    {% comment %} Bottom Call To Action (Optional) {% endcomment %}
    {% if section.settings.show_cta_button and section.settings.cta_button_text != blank %}
      <div class="wcu-bottom-cta-{{ section_id }}">
        <a href="{{ section.settings.cta_button_link | default: '#' }}" class="wcu-btn-{{ section_id }}">
          <span>{{ section.settings.cta_button_text }}</span>
          {% if section.settings.show_cta_arrow %}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          {% endif %}
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us (Features)",
  "tag": "section",
  "class": "section-why-choose-us-features",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Section Background & Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFF6E5"
    },
    {
      "type": "checkbox",
      "id": "enable_bg_gradient",
      "label": "Enable Background Gradient",
      "default": false
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(180deg, #FFF8EC 0%, #FFF3DC 100%)"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1360
    },
    {
      "type": "header",
      "content": "💡 Ambient Glow Effect"
    },
    {
      "type": "checkbox",
      "id": "enable_ambient_glow",
      "label": "Enable Center Ambient Glow",
      "default": true
    },
    {
      "type": "color",
      "id": "ambient_glow_color",
      "label": "Ambient Glow Color",
      "default": "#FFE4BA"
    },
    {
      "type": "range",
      "id": "ambient_glow_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Glow Opacity",
      "default": 55
    },
    {
      "type": "header",
      "content": "📝 Section Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Section Header",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow / Subtitle Text",
      "default": "WHY CHOOSE US"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow_icon",
      "label": "Show Eyebrow Icon",
      "default": true
    },
    {
      "type": "html",
      "id": "custom_eyebrow_icon",
      "label": "Custom Eyebrow SVG Icon (Optional)"
    },
    {
      "type": "select",
      "id": "eyebrow_style",
      "label": "Eyebrow Style",
      "options": [
        { "value": "plain", "label": "Plain Text" },
        { "value": "badge", "label": "Pill Badge with Background" }
      ],
      "default": "plain"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Text Color",
      "default": "#D97736"
    },
    {
      "type": "color",
      "id": "eyebrow_bg",
      "label": "Eyebrow Badge Background",
      "default": "#FFEAD2"
    },
    {
      "type": "range",
      "id": "eyebrow_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow Size (Desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow Size (Mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "px",
      "label": "Eyebrow Letter Spacing",
      "default": 2.5
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Main Heading",
      "default": "BECAUSE YOUR PET DESERVES THE BEST"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1E1E1E"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 26
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra Bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "800"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "min": 1,
      "max": 1.6,
      "step": 0.05,
      "label": "Heading Line Height",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "min": -2,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Heading Letter Spacing",
      "default": 0.5
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading / Description (Optional)"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "min": 500,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Header Max Width",
      "default": 860
    },
    {
      "type": "range",
      "id": "header_margin_bottom_desktop",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Header Bottom Margin (Desktop)",
      "default": 55
    },
    {
      "type": "range",
      "id": "header_margin_bottom_mobile",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Header Bottom Margin (Mobile)",
      "default": 30
    },
    {
      "type": "header",
      "content": "🖼️ Center Featured Image"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Featured Image"
    },
    {
      "type": "url",
      "id": "fallback_image_url",
      "label": "Fallback External Image URL",
      "info": "Used if no Shopify image is selected above"
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "min": 250,
      "max": 650,
      "step": 10,
      "unit": "px",
      "label": "Image Max Width (Desktop)",
      "default": 420
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "min": 180,
      "max": 450,
      "step": 10,
      "unit": "px",
      "label": "Image Max Width (Mobile)",
      "default": 280
    },
    {
      "type": "range",
      "id": "image_max_height_desktop",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Image Max Height (Desktop)",
      "default": 520
    },
    {
      "type": "range",
      "id": "image_max_height_mobile",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Image Max Height (Mobile)",
      "default": 320
    },
    {
      "type": "select",
      "id": "image_object_fit",
      "label": "Image Fit",
      "options": [
        { "value": "contain", "label": "Contain (Preserve Transparency/Aspect Ratio)" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_image_shadow",
      "label": "Enable Image Drop Shadow",
      "default": false
    },
    {
      "type": "color",
      "id": "image_shadow_color",
      "label": "Image Shadow Color",
      "default": "rgba(0, 0, 0, 0.12)"
    },
    {
      "type": "checkbox",
      "id": "enable_pedestal_shadow",
      "label": "Enable Ground Shadow Under Subject",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_floating_animation",
      "label": "Enable Gentle Floating Animation",
      "default": false
    },
    {
      "type": "header",
      "content": "📐 Layout & Alignment Controls"
    },
