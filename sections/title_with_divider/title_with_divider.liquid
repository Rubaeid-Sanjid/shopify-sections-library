{% assign section_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .custom-ornamental-divider-{{ section_id }} {
    display: block;
    width: 100%;
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .custom-ornamental-divider__container-{{ section_id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .custom-ornamental-divider__wrapper-{{ section_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: {{ section.settings.icon_text_gap }}px;
  }

  .custom-ornamental-divider__line-{{ section_id }} {
    flex-grow: 1;
    height: {{ section.settings.line_thickness }}px;
    {% if section.settings.line_style == 'gradient' %}
      background: linear-gradient(to right, transparent, {{ section.settings.line_color }}, transparent);
    {% else %}
      background-color: {{ section.settings.line_color }};
      {% if section.settings.line_style == 'dashed' %}
        background-image: repeating-linear-gradient(to right, {{ section.settings.line_color }} 0, {{ section.settings.line_color }} 10px, transparent 10px, transparent 20px);
      {% elsif section.settings.line_style == 'dotted' %}
        background-image: repeating-linear-gradient(to right, {{ section.settings.line_color }} 0, {{ section.settings.line_color }} 5px, transparent 5px, transparent 10px);
      {% endif %}
    {% endif %}
  }

  .custom-ornamental-divider__icon-{{ section_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size_desktop }}px;
    height: {{ section.settings.icon_size_desktop }}px;
  }

  .custom-ornamental-divider__icon-{{ section_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .custom-ornamental-divider__icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ section.settings.icon_color }};
  }

  .custom-ornamental-divider__title-{{ section_id }} {
    flex-shrink: 0;
    margin: 0;
    font-size: {{ section.settings.font_size_desktop }}px;
    color: {{ section.settings.title_color }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    font-weight: {{ section.settings.font_weight }};
    text-align: center;
    line-height: 1.2;
    {% if section.settings.font_family == 'serif' %}
      font-family: Georgia, 'Times New Roman', serif;
    {% elsif section.settings.font_family == 'sans-serif' %}
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    {% elsif section.settings.font_family == 'custom' %}
      font-family: {{ section.settings.custom_font_family }};
    {% endif %}
  }

  @media screen and (max-width: 767px) {
    .custom-ornamental-divider__title-{{ section_id }} {
      font-size: {{ section.settings.font_size_mobile }}px;
    }

    .custom-ornamental-divider__icon-{{ section_id }} {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }

    .custom-ornamental-divider__wrapper-{{ section_id }} {
      gap: calc({{ section.settings.icon_text_gap }}px * 0.75);
    }

    .custom-ornamental-divider__line-{{ section_id }} {
      height: calc({{ section.settings.line_thickness }}px * 0.8);
    }
  }
{% endstyle %}

<ornamental-divider-{{ section_id }}
  class="custom-ornamental-divider-{{ section_id }}"
  {{ section.shopify_attributes }}
>
  <div class="custom-ornamental-divider__container-{{ section_id }}">
    <div class="custom-ornamental-divider__wrapper-{{ section_id }}">
      {% if section.settings.show_lines %}
        <div class="custom-ornamental-divider__line-{{ section_id }}"></div>
      {% endif %}

      {% if section.settings.show_left_icon %}
        <div class="custom-ornamental-divider__icon-{{ section_id }} custom-ornamental-divider__icon-left-{{ section_id }}">
          {% if section.settings.left_icon != blank %}
            <img
              src="{{ section.settings.left_icon | image_url: width: 200 }}"
              alt="Left icon"
              loading="lazy"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
            >
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.title_text != blank %}
        <h2 class="custom-ornamental-divider__title-{{ section_id }}">
          {{ section.settings.title_text }}
        </h2>
      {% endif %}

      {% if section.settings.show_right_icon %}
        <div class="custom-ornamental-divider__icon-{{ section_id }} custom-ornamental-divider__icon-right-{{ section_id }}">
          {% if section.settings.right_icon != blank %}
            <img
              src="{{ section.settings.right_icon | image_url: width: 200 }}"
              alt="Right icon"
              loading="lazy"
              width="{{ section.settings.icon_size_desktop }}"
              height="{{ section.settings.icon_size_desktop }}"
            >
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_lines %}
        <div class="custom-ornamental-divider__line-{{ section_id }}"></div>
      {% endif %}
    </div>
  </div>
</ornamental-divider-{{ section_id }}>

<script>
  (function() {
    class OrnamentalDivider{{ section_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('ornamental-divider-{{ section_id }}', OrnamentalDivider{{ section_id }});
  })();
</script>

{% schema %}
{
  "name": "Ornamental divider title",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title text",
      "default": "FEATURED COLLECTION"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#222222"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        {
          "value": "sans-serif",
          "label": "Sans-serif"
        },
        {
          "value": "serif",
          "label": "Serif"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "sans-serif"
    },
    {
      "type": "text",
      "id": "custom_font_family",
      "label": "Custom font family",
      "info": "Enter font name (e.g., 'Playfair Display', 'Montserrat')"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size (desktop)",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size (mobile)",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Left icon"
    },
    {
      "type": "checkbox",
      "id": "show_left_icon",
      "label": "Show left icon",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "left_icon",
      "label": "Left icon image",
      "info": "Leave empty to use default heart icon"
    },
    {
      "type": "header",
      "content": "Right icon"
    },
    {
      "type": "checkbox",
      "id": "show_right_icon",
      "label": "Show right icon",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "right_icon",
      "label": "Right icon image",
      "info": "Leave empty to use default heart icon"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Icon size (desktop)",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size (mobile)",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#E0006C",
      "info": "Only applies to default SVG icons"
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Gap between icon and text",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Divider lines"
    },
    {
      "type": "checkbox",
      "id": "show_lines",
      "label": "Show divider lines",
      "default": true
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#E0006C"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Line style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "gradient",
          "label": "Gradient fade"
        }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 400,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#FFEFF4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Ornamental divider title"
    }
  ]
}
{% endschema %}