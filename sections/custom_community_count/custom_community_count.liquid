{% assign section_id = section.id | replace: '_', '' | downcase %}{% style %}.custom-community-stats-{{ section_id }}{display:block;width:100%;background:{{ section.settings.bg }};color:{{ section.settings.text }};}.custom-community-stats-{{ section_id }}__inner{width:{{ section.settings.desktop_width }}%;margin:auto;max-width:{{ section.settings.max_width }}px;padding:{{ section.settings.desktop_top }}px 24px {{ section.settings.desktop_bottom }}px;text-align:center;}.custom-community-stats-{{ section_id }} h2{margin:0 0 {{ section.settings.heading_gap }}px;font-size:{{ section.settings.heading_size }}px;color:{{ section.settings.heading_color }};}.custom-community-stats-{{ section_id }} p{margin:auto;font-size:{{ section.settings.body_size }}px;color:{{ section.settings.subtext }};max-width:{{ section.settings.body_width }}px;}.custom-community-stats-{{ section_id }}__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:{{ section.settings.gap }}px;margin:{{ section.settings.stats_top }}px 0 {{ section.settings.stats_bottom }}px;}.custom-community-stats-{{ section_id }}__value,.custom-community-stats-{{ section_id }}__suffix{font-size:{{ section.settings.number_size }}px;font-weight:700;color:{{ section.settings.number_color }};}.custom-community-stats-{{ section_id }}__label{font-size:{{ section.settings.label_size }}px;color:{{ section.settings.label_color }};}.custom-community-stats-{{ section_id }} a{display:inline-block;padding:{{ section.settings.button_v }}px {{ section.settings.button_h }}px;background:{{ section.settings.button_bg }};color:{{ section.settings.button_text }};border-radius:{{ section.settings.button_radius }}px;text-decoration:none;font-size:{{ section.settings.button_size }}px;}@media(max-width:749px){.custom-community-stats-{{ section_id }}__inner{width:100%;padding:{{ section.settings.mobile_top }}px 20px {{ section.settings.mobile_bottom }}px;}.custom-community-stats-{{ section_id }} h2{font-size:{{ section.settings.mobile_heading_size }}px;}.custom-community-stats-{{ section_id }} p{font-size:{{ section.settings.mobile_body_size }}px;}.custom-community-stats-{{ section_id }}__grid{grid-template-columns:repeat({{ section.settings.mobile_columns }},1fr);gap:{{ section.settings.mobile_gap }}px;}.custom-community-stats-{{ section_id }}__value,.custom-community-stats-{{ section_id }}__suffix{font-size:{{ section.settings.mobile_number_size }}px;}.custom-community-stats-{{ section_id }}__label{font-size:{{ section.settings.mobile_label_size }}px;}}{% endstyle %}<community-stats-{{ section_id }} class="custom-community-stats-{{ section_id }}" data-section-id="{{ section.id }}"><div class="custom-community-stats-{{ section_id }}__inner"><h2>{{ section.settings.heading }}</h2>{{ section.settings.description }}<div class="custom-community-stats-{{ section_id }}__grid">{% for i in (1..3) %}{% assign ck='stat_' | append:i | append:'_count' %}{% assign sk='stat_' | append:i | append:'_suffix' %}{% assign lk='stat_' | append:i | append:'_label' %}<div><span class="custom-community-stats-{{ section_id }}__value" data-count="{{ section.settings[ck] }}">0</span><span class="custom-community-stats-{{ section_id }}__suffix">{{ section.settings[sk] }}</span><div class="custom-community-stats-{{ section_id }}__label">{{ section.settings[lk] }}</div></div>{% endfor %}</div>{% if section.settings.button_label != blank and section.settings.button_link != blank %}<a href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></community-stats-{{ section_id }}><script>(function(){class X{{ section_id }} extends HTMLElement{connectedCallback(){if(this.x)return;this.x=1;let v=this.querySelectorAll('[data-count]'),o=new IntersectionObserver(e=>{if(e[0].isIntersecting){o.disconnect();let s=performance.now(),f=n=>{let p=Math.min((n-s)/2000,1),q=1-(1-p)**3;v.forEach(x=>x.textContent=new Intl.NumberFormat('en-US').format(p===1?parseInt(x.dataset.count)||0:Math.round((parseInt(x.dataset.count)||0)*q)));if(p<1)requestAnimationFrame(f)};requestAnimationFrame(f)}});o.observe(this)}}customElements.define('community-stats-{{ section_id }}',X{{ section_id }})})();</script>{% schema %}{"name":"Community stats","settings":[{"type":"text","id":"heading","label":"Heading","default":"Backed by a Community of Millions"},{"type":"richtext","id":"description","label":"Description","default":"<p>This isn't just merch, it's a way to represent the community that's been part of the journey from day one.</p>"},{"type":"text","id":"stat_1_count","label":"Stat 1 number","default":"1000000"},{"type":"text","id":"stat_1_suffix","label":"Stat 1 suffix","default":"+"},{"type":"text","id":"stat_1_label","label":"Stat 1 label","default":"YouTube Subscribers"},{"type":"text","id":"stat_2_count","label":"Stat 2 number","default":"300000"},{"type":"text","id":"stat_2_suffix","label":"Stat 2 suffix","default":"+"},{"type":"text","id":"stat_2_label","label":"Stat 2 label","default":"Community Members"},{"type":"text","id":"stat_3_count","label":"Stat 3 number","default":"100000"},{"type":"text","id":"stat_3_suffix","label":"Stat 3 suffix","default":"+"},{"type":"text","id":"stat_3_label","label":"Stat 3 label","default":"Happy Customers"},{"type":"text","id":"button_label","label":"Button label","default":"Join the community"},{"type":"url","id":"button_link","label":"Button link"},{"type":"range","id":"desktop_width","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"max_width","label":"Max width","min":800,"max":2000,"step":100,"unit":"px","default":1200},{"type":"range","id":"desktop_top","label":"Desktop top padding","min":0,"max":200,"step":10,"unit":"px","default":90},{"type":"range","id":"desktop_bottom","label":"Desktop bottom padding","min":0,"max":200,"step":10,"unit":"px","default":90},{"type":"range","id":"mobile_top","label":"Mobile top padding","min":0,"max":150,"step":10,"unit":"px","default":60},{"type":"range","id"