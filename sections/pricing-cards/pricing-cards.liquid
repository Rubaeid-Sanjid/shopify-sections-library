{% assign section_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .custom-pricing-section-{{ section_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;

    max-width: 1600px;
    margin: auto;
  }

  .custom-pricing-header-{{ section_id }} {
    text-align: center;
    margin-bottom: 40px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .custom-pricing-title-{{ section_id }} {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 16px 0 16px;
    font-family: var(--font-heading-family);
  }

  .custom-pricing-subtitle-{{ section_id }} {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    /* margin: 0 0 16px; */
  }

  .custom-pricing-description-{{ section_id }} {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .custom-pricing-container-{{ section_id }} {
    position: relative;
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .custom-pricing-grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.cards_per_row }}, 1fr);
    gap: {{ section.settings.card_spacing }}px;
  }

  .custom-pricing-card-{{ section_id }} {
    position: relative;
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    min-height: {{ section.settings.card_min_height }}px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .custom-pricing-card-{{ section_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }

  .custom-pricing-card-bg-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .custom-pricing-card-overlay-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .custom-pricing-card-link-{{ section_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    text-decoration: none;
  }

  .custom-pricing-card-content-{{ section_id }} {
    position: relative;
    z-index: 4;
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    pointer-events: none;
  }

  .custom-pricing-card-content-{{ section_id }}.align-left {
    align-items: flex-start;
    text-align: left;
  }

  .custom-pricing-card-content-{{ section_id }}.align-center {
    align-items: center;
    text-align: center;
  }

  .custom-pricing-card-content-{{ section_id }}.align-right {
    align-items: flex-end;
    text-align: right;
  }

  .custom-pricing-card-content-{{ section_id }} * {
    pointer-events: auto;
  }

  .custom-pricing-card-title-{{ section_id }} {
    font-size: {{ section.settings.card_title_size }}px;
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
  }

  .custom-pricing-card-description-{{ section_id }} {
    font-size: {{ section.settings.card_description_size }}px;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .custom-pricing-card-price-{{ section_id }} {
    font-size: {{ section.settings.card_price_size }}px;
    font-weight: 600;
    margin: 0 0 20px;
  }

  .custom-pricing-card-button-{{ section_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-align: center;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    font-size: {{ section.settings.button_text_size }}px;
  }

  .custom-pricing-card-button-{{ section_id }}:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_hover_text_color }};
  }

  .custom-pricing-slider-wrapper-{{ section_id }} {
    position: relative;
  }

  .custom-pricing-slider-{{ section_id }} {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    display: flex;
    gap: {{ section.settings.card_spacing }}px;
    padding: 0 20px;
  }

  .custom-pricing-slider-{{ section_id }}::-webkit-scrollbar {
    display: none;
  }

  .custom-pricing-slider-{{ section_id }} .custom-pricing-card-{{ section_id }} {
    flex: 0 0 85%;
    scroll-snap-align: center;
  }

  .custom-pricing-nav-{{ section_id }} {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .custom-pricing-nav-prev-{{ section_id }} {
    left: -20px;
  }

  .custom-pricing-nav-next-{{ section_id }} {
    right: -20px;
  }

  .custom-pricing-nav-button-{{ section_id }} {
    width: {{ section.settings.nav_button_size }}px;
    height: {{ section.settings.nav_button_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.nav_button_bg_color }};
    color: {{ section.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex !important;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);

    margin: 0 24px;
  }

  .custom-pricing-nav-button-{{ section_id }}:hover {
    background-color: {{ section.settings.nav_button_hover_bg_color }};
    color: {{ section.settings.nav_button_hover_color }};
  }

  .custom-pricing-nav-button-{{ section_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .custom-pricing-grid-{{ section_id }} {
      {% if section.settings.enable_mobile_slider %}
        display: none;
      {% else %}
        grid-template-columns: 1fr;
      {% endif %}
    }

    .custom-pricing-slider-wrapper-{{ section_id }} {
      {% if section.settings.enable_mobile_slider %}
        display: block;
      {% else %}
        display: none;
      {% endif %}
    }

    {% if section.settings.show_nav_buttons %}
      .custom-pricing-nav-{{ section_id }} {
        display: block;
      }
    {% endif %}

    .custom-pricing-title-{{ section_id }} {
      font-size: calc({{ section.settings.heading_size }}px * 0.7);
    }

    .custom-pricing-subtitle-{{ section_id }} {
      font-size: calc({{ section.settings.subheading_size }}px * 0.85);
    }

    .custom-pricing-description-{{ section_id }} {
      font-size: calc({{ section.settings.description_size }}px * 0.9);
    }
  }

  @media screen and (min-width: 750px) {
    .custom-pricing-slider-wrapper-{{ section_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="custom-pricing-section-{{ section_id }}" >
  {% if section.settings.section_title != blank or section.settings.section_subtitle != blank or section.settings.section_description != blank %}
    <div class="custom-pricing-header-{{ section_id }}">
      {% if section.settings.section_subtitle != blank %}
        <p class="custom-pricing-subtitle-{{ section_id }}">{{ section.settings.section_subtitle }}</p>
      {% endif %}
      {% if section.settings.section_title != blank %}
        <h2 class="custom-pricing-title-{{ section_id }}">{{ section.settings.section_title }}</h2>
      {% endif %}
      {% if section.settings.section_description != blank %}
        <div class="custom-pricing-description-{{ section_id }}">{{ section.settings.section_description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="custom-pricing-container-{{ section_id }}">
    <div class="custom-pricing-grid-{{ section_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_description_key = 'card_' | append: i | append: '_description'
          assign card_price_key = 'card_' | append: i | append: '_price'
          assign card_button_text_key = 'card_' | append: i | append: '_button_text'
          assign card_button_link_key = 'card_' | append: i | append: '_button_link'
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_overlay_color_key = 'card_' | append: i | append: '_overlay_color'
          assign card_overlay_opacity_key = 'card_' | append: i | append: '_overlay_opacity'
          assign card_text_color_key = 'card_' | append: i | append: '_text_color'
          assign card_link_key = 'card_' | append: i | append: '_link'
          assign card_alignment_key = 'card_' | append: i | append: '_alignment'

          assign card_title = section.settings[card_title_key]
          assign card_description = section.settings[card_description_key]
          assign card_price = section.settings[card_price_key]
          assign card_button_text = section.settings[card_button_text_key]
          assign card_button_link = section.settings[card_button_link_key]
          assign card_image = section.settings[card_image_key]
          assign card_overlay_color = section.settings[card_overlay_color_key]
          assign card_overlay_opacity = section.settings[card_overlay_opacity_key]
          assign card_text_color = section.settings[card_text_color_key]
          assign card_link = section.settings[card_link_key]
          assign card_alignment = section.settings[card_alignment_key]
        %}

        <div class="custom-pricing-card-{{ section_id }}">
          {% if card_image %}
            <div class="custom-pricing-card-bg-{{ section_id }}" style="background-image: url('{{ card_image | image_url: width: 800 }}');"></div>
          {% endif %}

          <div class="custom-pricing-card-overlay-{{ section_id }}" style="background-color: {{ card_overlay_color }}; opacity: {{ card_overlay_opacity | divided_by: 100.0 }};"></div>

          {% if card_link != blank %}
            <a href="{{ card_link }}" class="custom-pricing-card-link-{{ section_id }}" aria-label="{{ card_title }}"></a>
          {% endif %}

          <div class="custom-pricing-card-content-{{ section_id }} align-{{ card_alignment }}" style="color: {{ card_text_color }};">
            {% if card_title != blank %}
              <h3 class="custom-pricing-card-title-{{ section_id }}" style="color: {{ card_text_color }};">{{ card_title }}</h3>
            {% endif %}

            {% if card_description != blank %}
              <div class="custom-pricing-card-description-{{ section_id }}" style="color: {{ card_text_color }};">{{ card_description }}</div>
            {% endif %}

            {% if card_price != blank %}
              <div class="custom-pricing-card-price-{{ section_id }}" style="color: {{ card_text_color }};">{{ card_price }}</div>
            {% endif %}

            {% if card_button_text != blank and card_button_link != blank %}
              <a href="{{ card_button_link }}" class="custom-pricing-card-button-{{ section_id }}">{{ card_button_text }}</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="custom-pricing-slider-wrapper-{{ section_id }}">
      <div class="custom-pricing-slider-{{ section_id }}" id="custom-pricing-slider-{{ section_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign card_title_key = 'card_' | append: i | append: '_title'
            assign card_description_key = 'card_' | append: i | append: '_description'
            assign card_price_key = 'card_' | append: i | append: '_price'
            assign card_button_text_key = 'card_' | append: i | append: '_button_text'
            assign card_button_link_key = 'card_' | append: i | append: '_button_link'
            assign card_image_key = 'card_' | append: i | append: '_image'
            assign card_overlay_color_key = 'card_' | append: i | append: '_overlay_color'
            assign card_overlay_opacity_key = 'card_' | append: i | append: '_overlay_opacity'
            assign card_text_color_key = 'card_' | append: i | append: '_text_color'
            assign card_link_key = 'card_' | append: i | append: '_link'
            assign card_alignment_key = 'card_' | append: i | append: '_alignment'

            assign card_title = section.settings[card_title_key]
            assign card_description = section.settings[card_description_key]
            assign card_price = section.settings[card_price_key]
            assign card_button_text = section.settings[card_button_text_key]
            assign card_button_link = section.settings[card_button_link_key]
            assign card_image = section.settings[card_image_key]
            assign card_overlay_color = section.settings[card_overlay_color_key]
            assign card_overlay_opacity = section.settings[card_overlay_opacity_key]
            assign card_text_color = section.settings[card_text_color_key]
            assign card_link = section.settings[card_link_key]
            assign card_alignment = section.settings[card_alignment_key]
          %}

          <div class="custom-pricing-card-{{ section_id }}">
            {% if card_image %}
              <div class="custom-pricing-card-bg-{{ section_id }}" style="background-image: url('{{ card_image | image_url: width: 800 }}');"></div>
            {% endif %}

            <div class="custom-pricing-card-overlay-{{ section_id }}" style="background-color: {{ card_overlay_color }}; opacity: {{ card_overlay_opacity | divided_by: 100.0 }};"></div>

            {% if card_link != blank %}
              <a href="{{ card_link }}" class="custom-pricing-card-link-{{ section_id }}" aria-label="{{ card_title }}"></a>
            {% endif %}

            <div class="custom-pricing-card-content-{{ section_id }} align-{{ card_alignment }}" style="color: {{ card_text_color }};">
              {% if card_title != blank %}
                <h3 class="custom-pricing-card-title-{{ section_id }}" style="color: {{ card_text_color }};">{{ card_title }}</h3>
              {% endif %}

              {% if card_description != blank %}
                <div class="custom-pricing-card-description-{{ section_id }}" style="color: {{ card_text_color }};">{{ card_description }}</div>
              {% endif %}

              {% if card_price != blank %}
                <div class="custom-pricing-card-price-{{ section_id }}" style="color: {{ card_text_color }};">{{ card_price }}</div>
              {% endif %}

              {% if card_button_text != blank and card_button_link != blank %}
                <a href="{{ card_button_link }}" class="custom-pricing-card-button-{{ section_id }}">{{ card_button_text }}</a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <button class="custom-pricing-nav-{{ section_id }} custom-pricing-nav-prev-{{ section_id }} custom-pricing-nav-button-{{ section_id }}" aria-label="Previous slide">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button class="custom-pricing-nav-{{ section_id }} custom-pricing-nav-next-{{ section_id }} custom-pricing-nav-button-{{ section_id }}" aria-label="Next slide">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
(function() {
  const slider = document.getElementById('custom-pricing-slider-{{ section_id }}');
  const prevBtn = document.querySelector('.custom-pricing-nav-prev-{{ section_id }}');
  const nextBtn = document.querySelector('.custom-pricing-nav-next-{{ section_id }}');

  if (slider && prevBtn && nextBtn) {
    const cardWidth = slider.querySelector('.custom-pricing-card-{{ section_id }}').offsetWidth;
    const gap = {{ section.settings.card_spacing }};

    prevBtn.addEventListener('click', function() {
      slider.scrollBy({
        left: -(cardWidth + gap),
        behavior: 'smooth'
      });
    });

    nextBtn.addEventListener('click', function() {
      slider.scrollBy({
        left: cardWidth + gap,
        behavior: 'smooth'
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Pricing cards",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "richtext",
      "id": "section_title",
      "label": "Title",
      "default": "<p>RITUELS SIGNATURE</p>"
    },
    {
      "type": "richtext",
      "id": "section_subtitle",
      "label": "Subtitle",
      "default": "<p>Nos expériences complètes</p>"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Description",
      "default": "<p>Des rituels pensés pour une transformation profonde - corps, visage et esprit.</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
