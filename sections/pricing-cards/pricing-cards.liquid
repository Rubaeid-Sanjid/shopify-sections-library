      "default": "#5f8c88"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subtitle color",
      "default": "#5f8c88"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#7aa49f"
    },
